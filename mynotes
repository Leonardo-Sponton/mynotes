    def definir_fixada(self, r: Registro, fixada: bool):
        r.fixada = fixada
        self.marcar_alterado(r)
        self.salvar_agora(modificar=False)
        if r is self.atual:
            self.carregando = True
            self.bt_fixar.set_active(fixada)
