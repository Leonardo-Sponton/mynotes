        self.cad_erro.set_visible(True)

    def desbloquear(self):
        if self.ocupado or self.repo is not None:
            return
        segredo = self.cad_entrada.get_text()
        if not segredo:
            return
        rec = self.cad_modo_rec
        tipo = "recuperacao" if rec else "senha"
        if rec:
            segredo = normalizar_codigo(segredo)
        self.cad_entrada.set_text("")          # a senha não fica no campo
        self.set_focus(None)          # (tirar o foco antes de desativar o campo)
        self.cad_entrada.set_sensitive(False)
        self.cad_bt.set_sensitive(False)
        self.cad_spinner.set_visible(True)
        self.cad_erro.set_visible(False)
        pasta = self.pasta

        def trabalho():
            chave = abrir_cofre(pasta, segredo, tipo)
            return Repositorio(pasta, ArmazemCofre(pasta, chave))

        def fim(repo, erro):
            self.cad_spinner.set_visible(False)
            if erro is not None:
                self.falhas_senha += 1
                if isinstance(erro, SenhaIncorreta):
                    msg = ("Chave de recuperação incorreta." if rec else "Senha incorreta.")
                elif isinstance(erro, CofreError):
                    msg = f"Não foi possível abrir o cofre: {erro}. Nada foi alterado."
                else:
                    msg = f"Não foi possível abrir o cofre ({erro.__class__.__name__}). Nada foi alterado."
                espera = min(2 ** (self.falhas_senha - 3), 30) if self.falhas_senha >= 3 else 0
                if espera:
                    msg += f" Aguarde {espera} s para tentar de novo."
                self.mostrar_erro_cadeado(msg)

                def liberar():
                    self.cad_entrada.set_sensitive(True)
                    self.cad_bt.set_sensitive(True)
                    self.cad_entrada.grab_focus()
                    return False
                GLib.timeout_add_seconds(espera, liberar) if espera else liberar()
                return
            self.falhas_senha = 0
            self.cad_entrada.set_sensitive(True)
            self.cad_bt.set_sensitive(True)
            self.ativar(repo)
            if rec:
                self.dialogo_trocar_senha(exigir_atual=False,
                                          aviso="Você entrou com a chave de recuperação. Defina "
                                                "agora uma senha nova (recomendado).")
        self.em_segundo_plano(trabalho, fim)

    # ------------------------------------------------------------------
    # criar o cofre (migração assistida)
    # ------------------------------------------------------------------
    def assistente_cofre(self):
        if not tem_criptografia():
            self.erro_dialogo("Falta instalar a criptografia",
                              f"O cofre usa a biblioteca libsodium, pelo pacote {PACOTE_NACL}.\n\n"
                              f"No terminal:  sudo pacman -S {PACOTE_NACL}\n\nDepois feche e abra o "
                              "MyNotes de novo. Nada foi alterado.")
            return None
        self.salvar_agora()
        if self.pendentes:
            self.erro_dialogo("Há alterações não salvas",
