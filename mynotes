        self.recarregar_lista()

    def definir_humor(self, nome, ligar):
        r = self.atual
        if self.carregando or r is None or r.tipo != "diario":
            return
        if ligar:
            r.humor = nome
            self.carregando = True
            for outro, bt in self.bt_humor.items():
                if outro != nome:
                    bt.set_active(False)
            self.carregando = False
        elif r.humor == nome:
            r.humor = ""
        self.marcar_alterado(r)

    def alternar_virtude(self, campo, nome, ligar):
        r = self.atual
        if self.carregando or r is None or r.tipo != "exame":
            return
        v = getattr(r, campo)
        if ligar and nome not in v:
            v.append(nome)
        elif not ligar and nome in v:
            v.remove(nome)
        v.sort(key=[x[0] for x in VIRTUDES].index)
        self.marcar_alterado(r)

    def nova(self):
        if self.repo is None:
            return False
        if self.modo == "pensamento":
            self.formulario_pensamento()
            return
        if self.modo != "nota":
            self.busca.set_text("")
            self.abrir_dia(date.today())
            self.focar_corpo()
            return
        a = self.atual
        if a is not None and a.tipo == "nota" and not a.existe() and a.vazio():
            self.ent_titulo.grab_focus()    # já há uma nota nova em branco aberta
            return
        self.salvar_agora()
        r = self.repo.registro(self.repo.novo_rel_nota(), "nota")
        if self.filtro_tag:
            r.tags.append(self.filtro_tag)
        self.busca.set_text("")
        self.mostrar(r)
        self.recarregar_lista()
        self.ent_titulo.grab_focus()

    def apagar(self, r: Registro):
        if r is self.atual:
            self.salvar_agora()
        self.pendentes.discard(r)
        self.conflitos_avisados.discard(r)
        if not r.existe():
            return
        try:
            destino = self.repo.para_lixeira(r)
        except OSError as e:
            self.avisar(f"Não foi possível apagar: {e.strerror or e}")
            return
        if r in self.registros[r.tipo]:
            self.registros[r.tipo].remove(r)
        if r is self.atual:
            self.atual = None
            if r.tipo == "nota":
                self.recarregar_lista()
            else:
                self.abrir_dia(r.data())
        else:
            self.recarregar_lista()
        self.marcar_calendario()
        toast = Adw.Toast(title=f"“{r.titulo_exibido()}” foi para a lixeira", button_label="Desfazer",
                          timeout=10, use_markup=False)
        toast.connect("button-clicked", lambda *_: self.desfazer_apagar(r, destino))
        self.mostrar_toast(toast)

    def desfazer_apagar(self, r: Registro, destino: str):
        if self.repo is None or r.armazem is not self.repo.armazem:
            return
        self.salvar_agora()
        try:
            ok = self.repo.restaurar_da_lixeira(destino, r.rel)
        except OSError as e:
            self.avisar(f"Não foi possível desfazer: {e.strerror or e}")
            return
        if not ok:
            self.avisar("Não deu para desfazer: já existe outro registro com esse nome. "
                        f"O apagado continua em {destino}")
            return
        novo = self.repo.ler(r.rel, r.tipo)
        if novo is None:
            return
        self.adicionar_registro(novo)
        self.mostrar(novo)
        self.recarregar_lista()
        self.marcar_calendario()

    def abrir_externo(self, r: Registro):
        self.salvar_agora()
        if not (r.existe() and not r.armazem.cifrado):
            return
        # MYNOTES_EDITOR (ex.: "kate"), o Editor de Texto do GNOME ou o app padrão do sistema
        editor = os.environ.get("MYNOTES_EDITOR") or shutil.which("gnome-text-editor")
        if editor:
            with contextlib.suppress(OSError):
                subprocess.Popen([*shlex.split(editor), str(r.caminho)])
                return
        with contextlib.suppress(GLib.Error):
            Gio.AppInfo.launch_default_for_uri(Gio.File.new_for_path(str(r.caminho)).get_uri(), None)

    def abrir_pasta(self, pasta):
        with contextlib.suppress(GLib.Error):
            Gio.AppInfo.launch_default_for_uri(Gio.File.new_for_path(str(pasta)).get_uri(), None)

