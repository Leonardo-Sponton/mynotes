    def marcar_alterado(self, r: Registro):
        self.pendentes.add(r)
        if r is self.atual:
            self.definir_estado("salvando")
        if self.timer_salvar:
            GLib.source_remove(self.timer_salvar)
        self.timer_salvar = GLib.timeout_add(700, self.salvar_agora)

    def salvar_agora(self, modificar=True):
        """Grava tudo o que está pendente. Só marca "Salvo" depois de confirmar a gravação;
        se falhar, o texto continua no app (e na lista de pendentes) para tentar de novo."""
        if self.timer_salvar:
            GLib.source_remove(self.timer_salvar)
            self.timer_salvar = 0
        if not self.pendentes:
            return False
        novos = False
        for r in list(self.pendentes):
            if not r.existe() and r.vazio():
                self.pendentes.discard(r)      # dia sem nada escrito: não vira arquivo
                continue
            novo = not r.existe()
            try:
                r.salvar(modificar=modificar)
            except ConflitoError:
                self.avisar_conflito(r)
                continue
            except OSError as e:
                self.ultimo_erro = f"{r.nome}: {e.strerror or e}"
                continue
            self.pendentes.discard(r)
            self.conflitos_avisados.discard(r)
            if novo:
                self.adicionar_registro(r)
                novos = True
        if self.atual is not None:
            if self.atual in self.pendentes:
                self.definir_estado("conflito" if self.atual in self.conflitos_avisados else "falha")
            elif self.atual.existe():
                self.definir_estado("salvo")
                self.atualizar_props()
                self.bt_apagar.set_sensitive(True)
                self.bt_externo.set_sensitive(True)
            else:
                self.definir_estado("")
        if novos:
            self.recarregar_lista()
            self.marcar_calendario()
        else:
            self.atualizar_linha_atual()
        return False

    def definir_estado(self, estado):
        self.estado_atual = estado
        e = self.estado
        for c in ("ok", "erro"):
            e.remove_css_class(c)
        if not estado:
            e.set_visible(False)
            return
        textos = {
            "salvando": ("Salvando…", None, "As alterações serão gravadas em instantes."),
            "salvo": ("󰄬 Salvo", "ok", f"Gravado e conferido no disco às {datetime.now():%H:%M:%S}."),
            "falha": ("󰀦 Falha ao salvar", "erro",
                      f"{self.ultimo_erro}\nO texto continua aqui no app. Clique para tentar de novo."),
            "conflito": ("󰀦 Conflito", "erro",
                         "O arquivo foi alterado fora do app. Clique para escolher qual versão manter."),
        }
        texto, classe, dica = textos[estado]
        e.set_label(texto.split(" ")[0] if self.estreita and classe else texto)
        e.set_tooltip_text(dica)
        if classe:
            e.add_css_class(classe)
        e.set_visible(True)

    def on_estado(self):
        r = self.atual
        if r is not None and r in self.conflitos_avisados:
            self.avisar_conflito(r, de_novo=True)
        else:
            self.salvar_agora()

    def avisar_conflito(self, r: Registro, de_novo=False):
        if r in self.conflitos_avisados and not de_novo:
            return
        self.conflitos_avisados.add(r)
        d = Adw.AlertDialog(
            heading="O arquivo foi alterado fora do app",
            body=f"“{r.titulo_exibido()}” foi modificado fora deste app ("
                 + ("outra cópia do MyNotes ou uma restauração, por exemplo" if r.armazem.cifrado
                    else "por um editor externo, por exemplo")
                 + ") depois que foi aberto aqui.\n\nQual versão você quer manter? "
                 "Se escolher a do disco, a versão do app é guardada na lixeira.")
        d.add_response("depois", "Decidir depois")
        d.add_response("disco", "Usar a do disco")
        d.add_response("minha", "Manter a do app")
        d.set_response_appearance("minha", Adw.ResponseAppearance.SUGGESTED)
        d.set_default_response("depois")

        def resposta(_d, resp):
            try:
                if resp == "minha":
                    r.salvar(forcar=True)
                elif resp == "disco":
                    self.repo.guardar_copia(r)
                    r.carregar()
                else:
                    return
            except (OSError, UnicodeDecodeError, CofreError) as e:
                self.ultimo_erro = f"{r.nome}: {getattr(e, 'strerror', None) or e}"
                self.definir_estado("falha")
                return
            self.pendentes.discard(r)
            self.conflitos_avisados.discard(r)
            self.adicionar_registro(r)
            if r is self.atual:
                self.mostrar(r, forcar=True)
                self.definir_estado("salvo")
            self.recarregar_lista()
            self.marcar_calendario()
        d.connect("response", resposta)
        self.apresentar(d)

    def on_fechar(self, *_):
        if self.ocupado and not self.fechar_mesmo_assim:
            self.avisar("Espere a operação em andamento terminar antes de fechar.")
            return True
        self.salvar_agora()
        if not self.pendentes or self.fechar_mesmo_assim:
            return False
        nomes = "\n".join(f"• {r.titulo_exibido()}" for r in list(self.pendentes)[:6])
        d = Adw.AlertDialog(heading="Há alterações que não foram salvas",
                            body=f"{nomes}\n\n{self.ultimo_erro}\n\nSe fechar agora, elas se perdem.")
        d.add_response("voltar", "Voltar")
        d.add_response("fechar", "Fechar sem salvar")
        d.set_response_appearance("fechar", Adw.ResponseAppearance.DESTRUCTIVE)
        d.set_default_response("voltar")

        def resposta(_d, resp):
            if resp == "fechar":
                self.fechar_mesmo_assim = True
                self.close()
        d.connect("response", resposta)
        self.apresentar(d)
