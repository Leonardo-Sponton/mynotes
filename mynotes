    # ------------------------------------------------------------------
    # exibição
    # ------------------------------------------------------------------
    def mostrar(self, r: Registro | None, forcar=False):
        if r is self.atual and not forcar:
            return
        self.salvar_agora()
        if r is not None and r.existe() and r not in self.pendentes and r.alterado_fora():
            with contextlib.suppress(OSError, UnicodeDecodeError, CofreError):
                r.carregar()
        self.atual = r
        if r is None:
            self.pilha.set_visible_child_name("vazio")
            self.aplicar_visibilidade()
            return
        if r.tipo != self.modo:
            self.trocar_modo_visual(r.tipo)
        if r.tipo != "nota":
            self.datas[r.tipo] = r.data()
            self.sincronizar_calendario()

        self.carregando = True
        self.ent_titulo.set_text(r.titulo if r.tipo == "nota" else r.titulo_exibido())
        self.ent_titulo.definir_dica(r.titulo_padrao() if r.tipo != "nota" else "Título")
        if r.tipo == "exame":
            self.mostrar_exame(r)
            self.mostrar_pensamento_exame(r.data())
            self.dica.set_label("Preencha só as seções que fizerem sentido hoje; nenhuma é "
                                "obrigatória. As citações são contexto para inspirar, não regras.")
        else:
            self.editor.definir(r.texto)
            if r.tipo == "diario":
                self.editor.add_css_class("prosa")
                self.editor_box.dica.add_css_class("prosa")
                self.editor_box.dica.set_label("Como foi o seu dia? Escreva livremente.")
                self.dica.set_label("Nada aqui é obrigatório: escreva o que for relevante. "
                                    "Formatação: **negrito**, *itálico*, - lista, - [ ] tarefa, > citação.")
            else:
                self.editor.remove_css_class("prosa")
                self.editor_box.dica.remove_css_class("prosa")
                self.editor_box.dica.set_label("Escreva a nota…")
                self.dica.set_label("# título · **negrito** · *itálico* · `código` · - lista · "
                                    "- [ ] tarefa (clique para marcar) · > citação · ---")
        self.bt_feita.set_active(r.feita)
        self.bt_fixar.set_active(r.fixada)
        for nome, bt in self.bt_humor.items():
            bt.set_active(nome == r.humor)
        for campo in ("virtudes", "desenvolver"):
            for nome, bt in self.bt_virtudes[campo].items():
                bt.set_active(nome in getattr(r, campo))
        self.carregando = False

        self.atualizar_props()
        self.atualizar_tags_registro()
        self.aplicar_visibilidade()
        self.definir_estado("falha" if r in self.pendentes else "")
        self.pilha.set_visible_child_name("registro")
        self.rolagem.get_vadjustment().set_value(0)

    def mostrar_exame(self, r: Registro):
        livre, conhecidas, extras = dividir_secoes(r.texto)
        for chave, s in self.secoes.items():
            s.editor.definir(conhecidas.get(chave, ""))
        for s in self.secoes_extras:
            self.caixa_secoes.remove(s)
        self.secoes_extras = []
        if livre.strip():
            extras = [(None, livre), *extras]
        for i, (titulo, corpo) in enumerate(extras):
            s = SecaoExame(titulo or "Texto livre",
                           contexto="Pergunta de um modelo anterior, mantida como estava."
                           if titulo else "Texto escrito fora das seções.",
                           ao_mudar=self.on_mudou)
            s.titulo_md = titulo
            s.editor.definir(corpo)
            self.secoes_extras.append(s)
            self.caixa_secoes.insert_child_after(s, self.secoes_extras[i - 1] if i else None)
        # Na revisão de um exame passado, as perguntas em branco ficam escondidas
        # (um botão mostra todas, caso queira acrescentar algo).
        self.secoes_em_branco = []
        if r.existe() and r.data() < date.today():
            for chave, s in self.secoes.items():
                vazia = not conhecidas.get(chave, "").strip()
                if chave == "virtudes":
                    vazia = vazia and not (r.virtudes or r.desenvolver)
                if vazia:
                    self.secoes_em_branco.append(s)
        for s in self.secoes.values():
            s.set_visible(s not in self.secoes_em_branco)
        n = len(self.secoes_em_branco)
        self.bt_em_branco.set_label(f"Mostrar as {n} perguntas em branco" if n > 1
                                    else "Mostrar a pergunta em branco")
        self.bt_em_branco.set_visible(n > 0)

    def mostrar_em_branco(self):
        for s in self.secoes_em_branco:
            s.set_visible(True)
        self.secoes_em_branco = []
        self.bt_em_branco.set_visible(False)

    def texto_do_exame(self):
        conhecidas = {k: s.editor.conteudo() for k, s in self.secoes.items()}
        livre, extras = "", []
        for s in self.secoes_extras:
            if s.titulo_md is None:
                livre = s.editor.conteudo()
            else:
                extras.append((s.titulo_md, s.editor.conteudo()))
        return juntar_secoes(livre, conhecidas, extras)

    def aplicar_visibilidade(self):
        r = self.atual
        tipo = r.tipo if r else self.modo
        f = self.foco
        nota, diario, exame = tipo == "nota", tipo == "diario", tipo == "exame"
        self.card_pensamento.set_visible(exame and not f and self.pens_exame is not None)
        self.props.set_visible(not f)
        self.separador.set_visible(not f)
        self.dica.set_visible(not f)
        for nome, (rotulo, valor) in self.linhas_props.items():
            visivel = {"Status": nota, "Tags": nota, "O dia foi": diario,
                       "Feita em": nota and r is not None and r.feita}.get(nome, True)
            rotulo.set_visible(visivel)
            valor.set_visible(visivel)
        self.editor_box.set_visible(not exame)
        self.caixa_secoes.set_visible(exame)
        self.atualizar_secoes_diario()

        existe = r is not None and r.existe()
        pens = tipo == "pensamento"
        datas = diario or exame
        cifrado = self.repo is not None and self.repo.cifrado
        self.bt_feita.set_visible(nota and r is not None and not f)
        self.bt_fixar.set_visible(nota and r is not None and not f)
        self.nav_datas.set_visible(datas and not f)
        self.bt_ligacao.set_visible(datas and not f)
        self.bt_fechamento.set_visible(datas and not f)
        # com o cofre não há arquivo legível para abrir em outro programa
        self.bt_externo.set_visible(not f and not self.estreita and not pens and not cifrado)
        self.bt_apagar.set_visible(not f and not pens)
        self.bt_foco.set_visible(not pens)
        self.bt_apagar.set_sensitive(existe)
        self.bt_externo.set_sensitive(existe)
        if datas and self.repo is not None:
            d = self.datas[tipo]
            hoje = date.today()
            self.bt_data.set_label("Hoje" if d == hoje else "Ontem" if d == hoje - timedelta(days=1)
                                   else f"{d:%d/%m/%Y}")
            outro = "exame" if diario else "diario"
            tem = any(x.rel == self.repo.rel_do_dia(outro, d) for x in self.registros[outro])
            self.rotular(self.bt_ligacao, "󱅻" if diario else "󰠮",
                         "Exame deste dia" if diario else "Diário deste dia")
            self.bt_ligacao.set_tooltip_text(
                f"Abrir o {'exame' if diario else 'diário'} de {d:%d/%m} "
                f"({'já existe' if tem else 'ainda não escrito'}). Nada é copiado entre os dois.")
        self.rotular(self.bt_fechamento, "󰖔", "Fechar o dia")

    def rotular(self, bt, icone, texto):
        """Ícone + texto; só o ícone quando a janela está estreita (a dica explica)."""
        bt.set_child(Gtk.Label(label=icone if self.estreita else f"{icone}  {texto}"))

    def definir_estreita(self, estreita):
        self.estreita = estreita
        self.aplicar_visibilidade()
        self.atualizar_props()
        self.definir_estado(self.estado_atual)

    def atualizar_secoes_diario(self):
        r = self.atual
        mostrar = r is not None and r.tipo == "diario" and not self.foco
        faltando = 0
        for titulo, bt in self.bt_secoes_diario.items():
            tem = mostrar and re.search(rf"(?m)^## {re.escape(titulo)}\s*$", r.texto) is not None
            bt.set_visible(not tem)
            faltando += not tem
        self.caixa_add_secoes.set_visible(mostrar and faltando > 0)

    def inserir_secao_diario(self, titulo):
        buf = self.editor.get_buffer()
        texto = self.editor.conteudo()
        fim = buf.get_end_iter()
        prefixo = "" if not texto.strip() else ("\n" if texto.endswith("\n\n") else
                                                "\n\n" if not texto.endswith("\n") else "\n")
        buf.begin_user_action()
        buf.insert(fim, f"{prefixo}## {titulo}\n")
        buf.end_user_action()
        buf.place_cursor(buf.get_end_iter())
        self.editor.grab_focus()
        GLib.idle_add(lambda: self.editor.scroll_to_mark(buf.get_insert(), 0.1, False, 0, 0) and False)

    # ------------------------------------------------------------------
    # pensamentos: o do dia (no exame) e a biblioteca
    # ------------------------------------------------------------------
    @staticmethod
    def autor_de(p, com_epoca=True):
        if p["classificacao"] == "pessoal":
            return p["autor"] or "Reflexão pessoal"
        a = p["autor"]
        if com_epoca and p["epoca"]:
            a += f" ({p['epoca']})"
        return f"atribuído a {a}" if p["classificacao"] == "incerta" else a

    @staticmethod
    def obra_de(p):
        obra = p["obra"] if p["obra"] and p["obra"] not in p["autor"] else ""
        return ", ".join(x for x in (obra, p["referencia"]) if x)

    def mostrar_pensamento_exame(self, d: date):
        p, manual = self.biblioteca.do_dia(d) if self.biblioteca else (None, False)
        self.pens_exame = p
        if p is None:
            return
        self.lbl_cab_pensamento.set_label("󰝗  PENSAMENTO DO DIA" if d == date.today()
                                          else f"󰝗  PENSAMENTO DE {d:%d/%m}")
        self.lbl_citacao.set_label(f"“{p['texto']}”")
        obra = self.obra_de(p)
        self.lbl_autor.set_label(f"— {self.autor_de(p)}" + (f" · {obra}" if obra else ""))
        meta = [p["tradicao"], " · ".join(p["temas"][:4])]
        if manual:
            meta.append("escolhido por você")
        self.lbl_pens_meta.set_label("  ·  ".join(m for m in meta if m))
        self.lbl_pens_meta.set_visible(any(meta))

    def trocar_pensamento_do_exame(self):
        if not self.biblioteca:
            return
        d = self.atual.data() if self.atual is not None else date.today()
        p = self.biblioteca.aleatorio(evitar=self.pens_exame and self.pens_exame["id"])
        if p is None:
            return
        try:
            self.biblioteca.escolher(d, p["id"])
        except OSError as e:
            self.avisar(f"Não foi possível guardar a escolha: {e.strerror or e}")
        self.mostrar_pensamento_exame(d)

    def ir_para_pensamento(self, p):
        self.pens_atual = p
        if self.modo == "pensamento":
            self.mostrar_pensamento_biblioteca(p)
        else:
            self.modos.set_active_name("pensamento")

    def abrir_pensamento_do_dia(self):
        if self.biblioteca is None:
