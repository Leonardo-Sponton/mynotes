    def montar_acoes(self):
        self.acoes = {}
        for nome, func in (("exportar", self.exportar), ("backup", self.fazer_backup),
                           ("restaurar", self.restaurar_backup),
                           ("abrir-pasta", lambda: self.abrir_pasta(self.pasta)),
                           ("sobre-dados", self.sobre_dados),
                           ("criar-cofre", self.assistente_cofre),
                           ("bloquear", self.bloquear),
                           ("trocar-senha", lambda: self.dialogo_trocar_senha()),
                           ("recuperacao", self.dialogo_recuperacao),
                           ("remover-texto-puro", self.dialogo_remover_texto_puro),
                           ("lixeira", self.dialogo_lixeira)):
            acao = Gio.SimpleAction.new(nome, None)
            acao.connect("activate", lambda *_a, f=func: f())
            self.add_action(acao)
            self.acoes[nome] = acao
        auto = Gio.SimpleAction.new_stateful("bloqueio-auto", GLib.VariantType.new("s"),
                                             GLib.Variant("s", str(self.ajustes.get("bloqueio_min", 15))))
        auto.connect("change-state", self.on_bloqueio_auto)
        self.add_action(auto)
        self.acoes["bloqueio-auto"] = auto

        ctrl = Gtk.ShortcutController()
        for atalho, acao in (("<Control>n", self.nova),
                             ("<Control>f", self.busca.grab_focus),
                             ("<Control>s", lambda: self.salvar_agora() or True),
                             ("<Control>l", lambda: self.bloquear() or True),
                             ("<Control>1", lambda: self.modos.set_active_name("nota")),
                             ("<Control>2", lambda: self.modos.set_active_name("diario")),
                             ("<Control>3", lambda: self.modos.set_active_name("exame")),
                             ("<Control>4", lambda: self.modos.set_active_name("pensamento")),
                             ("<Alt>Left", lambda: self.dia_relativo(-1)),
                             ("<Alt>Right", lambda: self.dia_relativo(1)),
                             ("F11", self.alternar_foco),
                             ("Escape", lambda: self.foco and (self.alternar_foco() or True))):
            # a ação devolve False quando não fez nada (aí a tecla segue para o widget);
            # com o cofre bloqueado, nenhum atalho age sobre os dados
            ctrl.add_shortcut(Gtk.Shortcut.new(
                Gtk.ShortcutTrigger.parse_string(atalho),
                Gtk.CallbackAction.new(lambda *_, a=acao: self.repo is not None and not self.ocupado
                                       and a() is not False)))
        self.add_controller(ctrl)

    def atualizar_menu(self):
        """O menu ☰ muda conforme existe ou não o cofre."""
        cifrado = self.repo is not None and self.repo.cifrado
        menu = Gio.Menu()
        if cifrado:
            cofre = Gio.Menu()
            cofre.append("Bloquear agora (Ctrl+L)", "win.bloquear")
            cofre.append("Trocar a senha…", "win.trocar-senha")
            cofre.append("Chave de recuperação…", "win.recuperacao")
            auto = Gio.Menu()
            for minutos, rotulo in (("0", "Desligado"), ("5", "Após 5 minutos parado"),
                                    ("15", "Após 15 minutos parado"), ("30", "Após 30 minutos parado"),
                                    ("60", "Após 1 hora parado")):
                auto.append(rotulo, f"win.bloqueio-auto::{minutos}")
            cofre.append_submenu("Bloqueio automático", auto)
            if levantar_texto_puro(self.pasta)["registros"] or levantar_texto_puro(self.pasta)["copias"]:
