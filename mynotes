            return
        titulo = self.ent_titulo.get_text().strip()
        r.titulo = "" if titulo == r.titulo_padrao() else titulo
        r.texto = self.texto_do_exame() if r.tipo == "exame" else self.editor.conteudo()
        if r.tipo == "diario":
            self.atualizar_secoes_diario()
