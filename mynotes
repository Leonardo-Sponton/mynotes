# Armazenamento: pasta comum (Markdown legível) ou cofre (arquivos cifrados)
# Os dois oferecem a mesma interface, com caminhos lógicos como "diario/2026-10-13.md".
# ======================================================================
class ArmazemPasta:
    """Os arquivos Markdown de sempre, legíveis por qualquer editor."""

    cifrado = False

    def __init__(self, pasta):
        self.pasta = Path(pasta)
        self.erros: list[str] = []

    def _p(self, rel):
        return self.pasta / rel

    def existe(self, rel):
        return self._p(rel).is_file()

    def versao(self, rel):
        try:
            return self._p(rel).stat().st_mtime_ns
        except FileNotFoundError:
            return None

    def modificado_ns(self, rel):
        return self.versao(rel)

    def ler(self, rel) -> bytes:
        return self._p(rel).read_bytes()

    def gravar(self, rel, dados, modificado_ns=None) -> int:
        return escrever_atomico(self._p(rel), dados)

    def mover(self, rel, novo):
        destino = self._p(novo)
        if destino.exists():
            raise FileExistsError(errno.EEXIST, "já existe", novo)
        criar_pasta(destino.parent)
        os.replace(self._p(rel), destino)

    def apagar(self, rel):
        self._p(rel).unlink()

    def listar(self, sub="", padrao="*.md"):
        d = self._p(sub) if sub else self.pasta
        return sorted(p.relative_to(self.pasta).as_posix() for p in d.glob(padrao) if p.is_file())

    def listar_tudo(self, prefixo):
        base = self._p(prefixo)
        if not base.is_dir():
            return []
        return sorted(p.relative_to(self.pasta).as_posix() for p in base.rglob("*") if p.is_file())

    def atualizar(self):
        return False

    def fechar(self):
        pass


class ArmazemCofre:
    """Cada arquivo lógico vira <id aleatório>.bin, cifrado. O nome lógico, a data de
    modificação e o conteúdo ficam dentro da parte cifrada. Ao desbloquear, tudo é decifrado
    para a memória (é dali que a busca lê); nada é gravado em texto puro."""

    cifrado = True

    def __init__(self, pasta, chave, dir_blobs=None, carregar=True):
        exigir_nacl()
        self.pasta = Path(pasta)
        self.dir = Path(dir_blobs) if dir_blobs else self.pasta / DIR_COFRE
        self._chave = chave
        self._ids: dict[str, str] = {}       # rel -> id do arquivo
        self._ver: dict[str, int] = {}       # rel -> mtime_ns conhecido
        self._dados: dict[str, bytes] = {}
        self._mod: dict[str, int | None] = {}
        self.erros: list[str] = []
        if carregar:
            self.atualizar()

    def _arq(self, id_):
        return self.dir / f"{id_}.bin"

    def _decifrar_arquivo(self, p: Path):
        mtime = p.stat().st_mtime_ns
        bruto = decifrar(self._chave, p.read_bytes(), b"blob/" + p.stem.encode())
        rel, dados, mod = _desempacotar(bruto)
        return rel, dados, mod, mtime

    def _esquecer(self, rel):
        for d in (self._ids, self._ver, self._dados, self._mod):
            d.pop(rel, None)

    def atualizar(self) -> bool:
        """Lê o que mudou no disco desde a última vez. Devolve True se algo mudou."""
        if self._chave is None:
            return False
        mudou = False
        erros = []
        no_disco = {}
        if self.dir.is_dir():
            for p in self.dir.glob("*.bin"):
                if RE_ID.match(p.stem):
                    no_disco[p.stem] = p
        por_id = {i: r for r, i in self._ids.items()}
        for id_, rel in por_id.items():
            if id_ not in no_disco:
                self._esquecer(rel)
                mudou = True
        for id_, p in sorted(no_disco.items()):
            rel = por_id.get(id_)
            try:
                if rel is not None and self._ver.get(rel) == p.stat().st_mtime_ns:
                    continue
                novo_rel, dados, mod, mtime = self._decifrar_arquivo(p)
            except FileNotFoundError:
                continue
            except (OSError, CofreDanificado):
                erros.append(f"{p.name}: danificado ou de outro cofre (ignorado)")
                continue
            if rel is not None and rel != novo_rel:
                self._esquecer(rel)
            outro = self._ids.get(novo_rel)
            if outro is not None and outro != id_:
                if self._ver[novo_rel] >= mtime:
                    erros.append(f"{p.name}: cópia repetida de “{novo_rel}” (ignorada)")
                    continue
                erros.append(f"{outro}.bin: cópia repetida de “{novo_rel}” (ignorada)")
            self._ids[novo_rel], self._ver[novo_rel] = id_, mtime
            self._dados[novo_rel], self._mod[novo_rel] = dados, mod
            mudou = True
        self.erros = erros
        return mudou

    def existe(self, rel):
        return rel in self._ids

    def versao(self, rel):
        id_ = self._ids.get(rel)
        if id_ is None:
            return None
        try:
            return self._arq(id_).stat().st_mtime_ns
        except FileNotFoundError:
            return None

    def modificado_ns(self, rel):
        return self._mod.get(rel) or self._ver.get(rel)

    def ler(self, rel) -> bytes:
        if rel not in self._ids:
            raise FileNotFoundError(errno.ENOENT, "não existe no cofre", rel)
        v = self.versao(rel)
        if v is not None and v != self._ver[rel]:        # mudou no disco: decifra de novo
            novo_rel, dados, mod, mtime = self._decifrar_arquivo(self._arq(self._ids[rel]))
            if novo_rel != rel:
                self.atualizar()
                raise FileNotFoundError(errno.ENOENT, "não existe no cofre", rel)
            self._ver[rel], self._dados[rel], self._mod[rel] = mtime, dados, mod
        return self._dados[rel]

    def _gravar_id(self, id_, rel, dados, mod):
        blob = cifrar(self._chave, _empacotar(rel, dados, mod), b"blob/" + id_.encode())
        criar_pasta(self.dir)
        mtime = escrever_atomico(self._arq(id_), blob)
        # confere de novo: o que está no disco decifra para o mesmo conteúdo
        rel2, dados2, _mod, _m = self._decifrar_arquivo(self._arq(id_))
        if (rel2, dados2) != (rel, dados):
            raise OSError(errno.EIO, "o conteúdo cifrado não confere com o do app", rel)
        return mtime

    def gravar(self, rel, dados, modificado_ns=None) -> int:
        if self._chave is None:
            raise CofreError("o cofre está bloqueado")
        if not RE_REL.match(rel):
            raise ValueError(f"caminho inválido: {rel}")
        if isinstance(dados, str):
            dados = dados.encode("utf-8")
        import secrets
        id_ = self._ids.get(rel) or secrets.token_hex(16)
        mod = modificado_ns or time.time_ns()
        mtime = self._gravar_id(id_, rel, dados, mod)
        self._ids[rel], self._ver[rel], self._dados[rel], self._mod[rel] = id_, mtime, dados, mod
        return mtime

    def mover(self, rel, novo):
        if novo in self._ids:
            raise FileExistsError(errno.EEXIST, "já existe", novo)
        if not RE_REL.match(novo):
            raise ValueError(f"caminho inválido: {novo}")
        dados, mod, id_ = self.ler(rel), self._mod.get(rel), self._ids[rel]
        mtime = self._gravar_id(id_, novo, dados, mod)     # mesmo arquivo, troca atômica
        self._esquecer(rel)
        self._ids[novo], self._ver[novo], self._dados[novo], self._mod[novo] = id_, mtime, dados, mod

    def apagar(self, rel):
        id_ = self._ids[rel]
        self._arq(id_).unlink()
        self._esquecer(rel)

    def listar(self, sub="", padrao="*.md"):
        return sorted(r for r in self._ids
                      if posixpath.dirname(r) == sub and fnmatch.fnmatch(posixpath.basename(r), padrao))

    def listar_tudo(self, prefixo):
        return sorted(r for r in self._ids if r.startswith(prefixo.rstrip("/") + "/"))

    def todos(self):
        return sorted(self._ids)

    def arquivo_de(self, rel) -> Path:
        return self._arq(self._ids[rel])

    def fechar(self):
        """Esquece a chave e o conteúdo decifrado (o Python não garante que a memória seja
        apagada de imediato; ver o README)."""
        self._chave = None
        for d in (self._ids, self._ver, self._dados, self._mod):
            d.clear()


class Registro:
    """Uma nota, uma entrada de diário ou um exame: um arquivo Markdown (na pasta comum ou
    dentro do cofre). Um registro pode ainda não existir ("virtual"): o diário de um dia em
    que nada foi escrito. Ele só vira arquivo quando recebe algum conteúdo."""

    def __init__(self, armazem, rel, tipo):
        self.armazem = armazem
        self.rel = rel
        self.tipo = tipo
        self._limpar()
        if armazem.existe(rel):
            self.carregar()

    def _limpar(self):
        self.titulo = ""          # "" = título padrão ("Sem título" ou a data)
        self.feita = False
        self.fixada = False
        self.criada = agora()
        self.modificada = ""
        self.feita_em = ""
        self.tags: list[str] = []
        self.virtudes: list[str] = []
        self.desenvolver: list[str] = []
        self.humor = ""
        self.texto = ""
        self.mtime = None         # versão do disco que o app conhece

    @property
    def nome(self):
        return posixpath.basename(self.rel)

    @property
    def caminho(self) -> Path:
        """Caminho na pasta comum (com o cofre, não existe arquivo legível com esse nome)."""
        return self.armazem.pasta / self.rel

    def data(self) -> date:
        if self.tipo != "nota":
            with contextlib.suppress(ValueError):
                return date.fromisoformat(posixpath.splitext(self.nome)[0])
        d = ler_data(self.criada)
        return d.date() if d else date.today()

    def titulo_padrao(self):
        return "Sem título" if self.tipo == "nota" else titulo_do_dia(self.data())

    def titulo_exibido(self):
        return self.titulo or self.titulo_padrao()

    def existe(self):
        return self.armazem.existe(self.rel)

    def vazio(self):
        return not (self.texto.strip() or self.titulo or self.tags or self.virtudes
                    or self.desenvolver or self.humor or self.fixada or self.feita)

    def carregar(self):
        versao = self.armazem.versao(self.rel)
        conteudo = self.armazem.ler(self.rel).decode("utf-8").replace("\r\n", "\n")
        self._limpar()
        linhas = conteudo.split("\n")
        inicio = 0
        listas = lambda v: [t.strip() for t in v.split(",") if t.strip()]  # noqa: E731
        for i, l in enumerate(linhas[:20]):
            chave, sep, valor = l.partition(":")
            chave, valor = chave.strip().lower(), valor.strip()
            if i == 0 and l.startswith("# "):
                self.titulo = l[2:].strip()
            elif not sep:
                break
            elif chave == "status":
                self.feita = valor.lower() == "feita"
            elif chave == "criada":
                self.criada = valor
            elif chave == "modificada":
                self.modificada = valor
            elif chave == "feita_em":
                self.feita_em = valor
            elif chave == "fixada":
                self.fixada = valor.lower() in ("sim", "true", "1")
            elif chave == "humor":
                self.humor = valor
            elif chave == "tags":
                self.tags = listas(valor)
            elif chave == "virtudes":
                self.virtudes = listas(valor)
            elif chave == "desenvolver":
                self.desenvolver = listas(valor)
            else:
                break
            inicio = i + 1
        if self.titulo == self.titulo_padrao():
            self.titulo = ""
        if not self.modificada:
            ns = self.armazem.modificado_ns(self.rel) or versao or time.time_ns()
            self.modificada = datetime.fromtimestamp(ns / 1e9).strftime(FORMATO)
        self.texto = "\n".join(linhas[inicio:]).strip("\n")
        self.mtime = versao

    def serializar(self):
        meta = [f"# {self.titulo_exibido()}"]
        if self.tipo == "nota":
            meta.append(f"status: {'feita' if self.feita else 'pendente'}")
        meta += [f"criada: {self.criada}", f"modificada: {self.modificada}"]
        if self.tipo == "nota" and self.fixada:
            meta.append("fixada: sim")
        if self.tipo == "diario" and self.humor:
            meta.append(f"humor: {self.humor}")
        if self.tipo == "exame" and self.virtudes:
            meta.append(f"virtudes: {', '.join(self.virtudes)}")
        if self.tipo == "exame" and self.desenvolver:
            meta.append(f"desenvolver: {', '.join(self.desenvolver)}")
        if self.feita and self.feita_em:
            meta.append(f"feita_em: {self.feita_em}")
        if self.tags:
            meta.append(f"tags: {', '.join(self.tags)}")
        return "\n".join(meta) + f"\n\n{self.texto}\n"

    def alterado_fora(self):
        """O arquivo no disco mudou desde a última leitura/gravação deste app?"""
        v = self.armazem.versao(self.rel)
        if v is None:
            return False
        return self.mtime is None or v != self.mtime

    def salvar(self, modificar=True, forcar=False):
        if not forcar and self.alterado_fora():
            raise ConflitoError(self.rel)
        if modificar or not self.modificada:
            self.modificada = agora()
        self.mtime = self.armazem.gravar(self.rel, self.serializar().encode("utf-8"))

    def para_dict(self):
        d = {"arquivo": self.nome, "tipo": self.tipo, "titulo": self.titulo_exibido(),
             "criada": self.criada, "modificada": self.modificada}
        if self.tipo == "nota":
            d.update(status="feita" if self.feita else "pendente", fixada=self.fixada,
                     tags=self.tags, feita_em=self.feita_em or None)
        else:
            d["data"] = self.data().isoformat()
        if self.tipo == "diario":
            d["humor"] = self.humor or None
        if self.tipo == "exame":
            livre, conhecidas, extras = dividir_secoes(self.texto)
            secoes = {t: conhecidas[k] for k, t, *_ in SECOES_EXAME if conhecidas.get(k, "").strip()}
            secoes.update((t, c) for t, c in extras if c.strip())
            d.update(virtudes=self.virtudes, desenvolver=self.desenvolver, secoes=secoes,
                     texto_livre=livre or None)
        d["texto"] = self.texto
        return d


def _norm_titulo(t):
    return dobrar(t.strip().rstrip("?:.").strip())


_TITULO_PARA_CHAVE = {_norm_titulo(t): k for k, t, *_ in SECOES_EXAME}
_TITULO_PARA_CHAVE.update((_norm_titulo(t), k) for t, k in APELIDOS_EXAME.items())


def dividir_secoes(texto):
    """Corpo de um exame -> (texto antes da 1ª seção, {chave: conteúdo}, [(título, conteúdo)])
    As seções que não são do modelo atual (ex.: as perguntas de Sêneca) vão para a lista."""
    blocos = [[None, []]]
    for linha in texto.split("\n"):
        if linha.startswith("## "):
            blocos.append([linha[3:].strip(), []])
        else:
            blocos[-1][1].append(linha)
    livre, conhecidas, extras = "", {}, []
    for titulo, linhas in blocos:
        corpo = "\n".join(l for l in linhas if l.strip() not in DICAS_ANTIGAS).strip("\n")
        if titulo is None:
            livre = corpo
            continue
        chave = _TITULO_PARA_CHAVE.get(_norm_titulo(titulo))
        if chave is None:
            extras.append((titulo, corpo))
        elif conhecidas.get(chave, "").strip():
            conhecidas[chave] += f"\n\n{corpo}"
        else:
            conhecidas[chave] = corpo
    return livre, conhecidas, extras


def juntar_secoes(livre, conhecidas, extras):
    """Monta o corpo do exame: texto solto, seções de modelos antigos e as seções atuais.
    Seções vazias não vão para o arquivo."""
    partes = [livre.strip("\n")] if livre.strip() else []
    for titulo, corpo in extras:
        if corpo.strip():
            partes.append(f"## {titulo}\n\n{corpo.strip(chr(10))}")
    for chave, titulo, *_ in SECOES_EXAME:
        corpo = conhecidas.get(chave, "")
        if corpo.strip():
            partes.append(f"## {titulo}\n\n{corpo.strip(chr(10))}")
    return "\n\n".join(partes)


def acrescentar_em_secao(texto, titulo, conteudo):
    """Acrescenta `conteudo` ao fim da seção "## titulo" (criando-a no fim, se não existir).
    Com titulo=None, acrescenta ao fim do texto. Nada do que já existe é alterado."""
    conteudo = conteudo.strip("\n")
    if titulo is None:
        return f"{texto.rstrip()}\n\n{conteudo}" if texto.strip() else conteudo
    linhas = texto.split("\n")
    alvo = _norm_titulo(titulo)
    ini = next((i for i, l in enumerate(linhas)
                if l.startswith("## ") and _norm_titulo(l[3:]) == alvo), None)
    if ini is None:
        base = texto.rstrip()
        return (f"{base}\n\n" if base else "") + f"## {titulo}\n\n{conteudo}"
    fim = next((j for j in range(ini + 1, len(linhas)) if linhas[j].startswith("## ")), len(linhas))
    secao = "\n".join(linhas[ini + 1:fim]).strip("\n")
    nova = f"{secao}\n\n{conteudo}" if secao.strip() else conteudo
    depois = "\n".join(linhas[fim:]).strip("\n")
    resultado = "\n".join(linhas[:ini + 1]) + f"\n\n{nova}"
    return resultado + (f"\n\n{depois}" if depois else "")


def campos_busca(r: Registro):
    return [r.titulo_exibido(), r.texto, *r.tags, *r.virtudes, *r.desenvolver, r.humor]


def buscar(registros, termo, tipos=None, desde=None):
    t = dobrar(termo.strip().lstrip("#"))
    for r in registros:
        if tipos and r.tipo not in tipos:
            continue
        if desde and r.data() < desde:
            continue
        if t and not any(t in dobrar(c) for c in campos_busca(r) if c):
            continue
        yield r


def trecho(texto, termo, largura=80):
    """Pedaço do texto em volta do termo buscado: (antes, encontrado, depois)."""
    plano = " ".join(re.sub(r"(?m)^#+ |[*`>]|^- \[[ xX]\] ", "", texto).split())
    t = dobrar(termo.strip().lstrip("#"))
    i = dobrar(plano).find(t) if t else -1
    if i < 0:
        return (plano[:largura] + ("…" if len(plano) > largura else ""), "", "")
    ini = max(0, i - largura // 3)
    fim = max(ini + largura, i + len(t))
    return (("…" if ini else "") + plano[ini:i], plano[i:i + len(t)],
            plano[i + len(t):fim] + ("…" if fim < len(plano) else ""))


class Repositorio:
    """Os dados do app: registros, lixeira, tags, exportação, backup e restauração.
    Funciona igual sobre a pasta comum e sobre o cofre (self.armazem)."""

    RE_BACKUP = re.compile(r"^(?:(?:diario|exames)/)?[^/\\.][^/\\]*\.md$")
    RE_BLOB_BACKUP = re.compile(r"^cofre/([0-9a-f]{32})\.bin$")

    def __init__(self, pasta=PASTA, armazem=None):
        self.pasta = Path(pasta)
        self.armazem = armazem or ArmazemPasta(self.pasta)
        self.seguranca = self.pasta / ".seguranca"
        self.erros: list[str] = []   # arquivos que não puderam ser lidos

    @property
    def cifrado(self):
        return self.armazem.cifrado

    def preparar(self):
        criar_pasta(self.pasta)
        proteger(self.pasta, 0o700)
        if self.cifrado:
            criar_pasta(self.armazem.dir)
            proteger(self.armazem.dir, 0o700)
            proteger(self.pasta / ARQ_COFRE, 0o600)
            for p in self.armazem.dir.glob("*.bin"):
                proteger(p, 0o600)
        else:
            for tipo in TIPOS:
                criar_pasta(self.pasta / TIPOS[tipo][0])
                proteger(self.pasta / TIPOS[tipo][0], 0o700)
            for rel in self.arquivos():
                proteger(self.pasta / rel, 0o600)
            lixeira = self.pasta / ".lixeira"
            if lixeira.is_dir():
                proteger(lixeira, 0o700)
                for p in lixeira.rglob("*"):
                    proteger(p, 0o700 if p.is_dir() else 0o600)
        if not self.armazem.existe(".tags.json"):
            self.salvar_tags([dict(t) for t in TAGS_PADRAO])
        if not self.cifrado:
            proteger(self.pasta / ".tags.json", 0o600)

    def arquivos(self, tipo=None):
        for t in ([tipo] if tipo else TIPOS):
            yield from self.armazem.listar(TIPOS[t][0])

    def registro(self, rel, tipo) -> Registro:
        return Registro(self.armazem, rel, tipo)

    def ler(self, rel, tipo):
        try:
            return Registro(self.armazem, rel, tipo)
        except (OSError, UnicodeDecodeError, CofreError) as e:
            self.erros.append(f"{posixpath.basename(rel)}: {e.__class__.__name__}")
            return None

    def carregar(self, tipo):
        return [r for rel in self.arquivos(tipo) if (r := self.ler(rel, tipo))]

    def rel_do_dia(self, tipo, d: date):
        return posixpath.join(TIPOS[tipo][0], f"{d:%Y-%m-%d}.md")

    def novo_rel_nota(self):
        base = datetime.now().strftime("%Y-%m-%d")
        n = 1
        while self.armazem.existe(rel := f"{base}-{n:02d}.md"):
            n += 1
        return rel

    # ----- tags -----
    def carregar_tags(self):
        try:
            tags = json.loads(self.armazem.ler(".tags.json").decode("utf-8"))
            return [t for t in tags if isinstance(t, dict) and t.get("nome")]
        except (OSError, ValueError, CofreError):
            return [dict(t) for t in TAGS_PADRAO]

    def salvar_tags(self, tags):
        self.armazem.gravar(".tags.json", json.dumps(tags, ensure_ascii=False, indent=2))

    # ----- lixeira -----
    def para_lixeira(self, reg: Registro) -> str:
        base = f".lixeira/{TIPOS[reg.tipo][0] or 'notas'}"
        destino = f"{base}/{reg.nome}"
        if self.armazem.existe(destino):
            destino = f"{base}/{posixpath.splitext(reg.nome)[0]}--{datetime.now():%Y%m%d-%H%M%S-%f}.md"
        self.armazem.mover(reg.rel, destino)
        return destino

    def restaurar_da_lixeira(self, destino: str, original: str) -> bool:
        if self.armazem.existe(original):
            return False
        self.armazem.mover(destino, original)
        return True

    def guardar_copia(self, reg: Registro) -> str:
        """Guarda na lixeira a versão do app antes de descartá-la (num conflito)."""
        destino = (f".lixeira/conflitos/{posixpath.splitext(reg.nome)[0]}"
                   f"--{datetime.now():%Y%m%d-%H%M%S-%f}.md")
        self.armazem.gravar(destino, reg.serializar())
        return destino

    def lixeira(self):
        return self.armazem.listar_tudo(".lixeira")

    SUB_LIXEIRA = {"notas": "nota", "diario": "diario", "exames": "exame"}

    def item_lixeira(self, rel):
        """(tipo, caminho original, Registro) de um item da lixeira; tipo None = conflito."""
        _, sub, nome = rel.split("/", 2)
        tipo = self.SUB_LIXEIRA.get(sub)
        base = re.sub(r"--\d{8}-\d{6}-\d+(?=\.md$)", "", nome)
        original = posixpath.join(TIPOS[tipo][0], base) if tipo else None
        return tipo, original, Registro(self.armazem, rel, tipo or "nota")

    def restaurar_item_lixeira(self, rel):
        """Devolve o item ao lugar de origem; se já existe outro lá, usa um nome novo (notas)
        ou recusa (diário/exame do mesmo dia). Devolve o caminho restaurado ou None."""
        tipo, original, _ = self.item_lixeira(rel)
        if tipo is None:
            original = self.novo_rel_nota()
        elif self.armazem.existe(original):
            if tipo != "nota":
                return None
            original = self.novo_rel_nota()
        self.armazem.mover(rel, original)
        return original

    # ----- exportação (texto puro, só quando pedida) -----
    def exportar(self, destino_pai) -> Path:
        """Cria uma pasta com os .md (notas/, diario/, exames/) e um mynotes.json.
        Com o cofre, isto gera cópias SEM proteção: a interface avisa e pede confirmação."""
        alvo = Path(destino_pai) / f"mynotes-exportacao-{datetime.now():%Y-%m-%d-%H%M%S}"
        alvo.mkdir(mode=0o700)
        nomes = {"nota": "notas", "diario": "diario", "exame": "exames"}
        dados = {"formato": "mynotes-exportacao", "versao": 1, "exportado_em": agora(),
                 "tags": self.carregar_tags()}
        for tipo, nome in nomes.items():
            criar_pasta(alvo / nome)
            dados[nome] = []
            for rel in self.arquivos(tipo):
                escrever_atomico(alvo / nome / posixpath.basename(rel), self.armazem.ler(rel))
                if r := self.ler(rel, tipo):
                    dados[nome].append(r.para_dict())
        with contextlib.suppress(OSError, ValueError, CofreError):
            p = json.loads(self.armazem.ler(".pensamentos.json").decode("utf-8"))
            dados["pensamentos_proprios"] = p.get("proprios", [])
            dados["pensamentos_favoritos"] = p.get("favoritos", [])
        escrever_atomico(alvo / "mynotes.json", json.dumps(dados, ensure_ascii=False, indent=2))
        return alvo

    # ----- backup e restauração -----
    def rels_backup(self):
        return [*self.arquivos(), *(e for e in EXTRAS if self.armazem.existe(e))]

    def fazer_backup(self, destino) -> int:
        """Zip com todos os registros, as tags e os pensamentos próprios (sem a lixeira).
        Com o cofre, o zip leva os arquivos cifrados e o cofre.json: continua protegido pela
        senha. Devolve quantos registros foram incluídos."""
        destino = Path(destino)
        fd, tmp = tempfile.mkstemp(dir=destino.parent, prefix=".mynotes-backup-", suffix=".tmp")
        os.close(fd)
        n = 0
        try:
            with zipfile.ZipFile(tmp, "w", zipfile.ZIP_DEFLATED) as z:
                if self.cifrado:
                    z.writestr("cofre.json", (self.pasta / ARQ_COFRE).read_bytes())
                    z.writestr("LEIA-ME.txt", LEIA_ME_BACKUP_CIFRADO)
                for rel in self.rels_backup():
                    if self.cifrado:
                        self.armazem.ler(rel)        # confere que ainda decifra
                        arq = self.armazem.arquivo_de(rel)
                        z.writestr(f"cofre/{arq.name}", arq.read_bytes())
                    else:
                        info = zipfile.ZipInfo(rel, datetime.fromtimestamp(
                            self.armazem.versao(rel) / 1e9).timetuple()[:6])
                        info.compress_type = zipfile.ZIP_DEFLATED
                        z.writestr(info, self.armazem.ler(rel))
                    n += rel not in EXTRAS
            with zipfile.ZipFile(tmp) as z:
                if z.testzip() is not None:
                    raise OSError(errno.EIO, "o backup gerado está corrompido")
            os.replace(tmp, destino)
        except BaseException:
            with contextlib.suppress(OSError):
                os.unlink(tmp)
            raise
        return n

    def ler_backup(self, origem, senha=None):
        """Lê e confere o backup inteiro na memória, sem mexer em nada.
        Devolve ({rel: (bytes, mod)}, ignorados). Backups cifrados: tenta a chave atual; se o
        backup for de outra chave, levanta PrecisaSenha (ou usa `senha`)."""
        with zipfile.ZipFile(origem) as z:
            nomes = [n for n in z.namelist() if not n.endswith("/")]
            conteudos = {}
            if "cofre.json" in nomes:
                if not self.cifrado:
                    raise ValueError("Este backup é cifrado. Para restaurá-lo, crie antes um cofre "
                                     "(menu ☰ → Proteger com senha…).")
                try:
                    cab = validar_cabecalho(json.loads(z.read("cofre.json").decode("utf-8")))
                except (ValueError, UnicodeDecodeError):
                    raise ValueError("O cofre.json deste backup está danificado.") from None
                blobs = [(m.group(1), z.read(n)) for n in nomes if (m := self.RE_BLOB_BACKUP.match(n))]
                if not blobs:
                    raise ValueError("Este backup cifrado não tem registros.")
                chave = self.armazem._chave
                try:
                    decifrar(chave, blobs[0][1], b"blob/" + blobs[0][0].encode())
                except CofreDanificado:
                    if senha is None:
                        raise PrecisaSenha() from None
                    chave = None
                    for tipo in ("senha", "recuperacao"):
                        env = cab["envelopes"].get(tipo)
                        segredo = senha if tipo == "senha" else normalizar_codigo(senha)
                        if env and segredo:
                            with contextlib.suppress(SenhaIncorreta):
                                chave = abrir_envelope(env, tipo, segredo)
                                break
                    if chave is None:
                        raise SenhaIncorreta() from None
                for id_, blob in blobs:
                    try:
                        rel, dados, mod = _desempacotar(decifrar(chave, blob, b"blob/" + id_.encode()))
                    except CofreDanificado:
                        raise ValueError("O backup está danificado ou foi alterado: nada foi "
                                         "restaurado.") from None
                    if rel.startswith(".lixeira/"):
                        continue
                    conteudos[rel] = (dados, mod)
                ignorados = len(nomes) - len(blobs) - 1 - ("LEIA-ME.txt" in nomes)
            else:
                validos = [n for n in nomes if self.RE_BACKUP.match(n) or n in EXTRAS]
                if not any(self.RE_BACKUP.match(n) for n in validos) and ".tags.json" not in validos:
                    raise ValueError("Este arquivo não parece um backup do MyNotes.")
                for n in validos:
                    dados = z.read(n)
                    try:
                        dados.decode("utf-8")
                    except UnicodeDecodeError:
                        raise ValueError(f"“{n}” no backup não é um texto válido.") from None
                    conteudos[n] = (dados, None)
                ignorados = len(nomes) - len(validos)
        return conteudos, ignorados

    def restaurar_backup(self, origem, senha=None):
        """Restaura um zip feito por fazer_backup. Registros com o mesmo nome são substituídos
        pela versão do backup; os demais ficam como estão. Antes, confere o backup inteiro e
        guarda o estado atual em .seguranca/ (cifrado, se houver cofre). Se algo falhar no
        meio, desfaz o que já tinha sido gravado. Devolve (restaurados, ignorados, cópia)."""
        conteudos, ignorados = self.ler_backup(origem, senha)
        criar_pasta(self.seguranca)
        proteger(self.seguranca, 0o700)
        copia = self.seguranca / f"antes-de-restaurar-{datetime.now():%Y-%m-%d-%H%M%S-%f}.zip"
        self.fazer_backup(copia)
        anteriores: dict[str, bytes] = {}
        novos: list[str] = []

        def gravar(rel, dados, mod=None):
            if self.armazem.existe(rel):
                anteriores.setdefault(rel, self.armazem.ler(rel))
            elif rel not in novos:
                novos.append(rel)
            self.armazem.gravar(rel, dados, mod)

        try:
            for rel, (dados, mod) in conteudos.items():
                if rel not in EXTRAS:
                    gravar(rel, dados, mod)
            if ".tags.json" in conteudos:
                with contextlib.suppress(ValueError, UnicodeDecodeError):
                    tags = [t for t in json.loads(conteudos[".tags.json"][0].decode("utf-8"))
                            if isinstance(t, dict) and t.get("nome")]
                    atuais = self.carregar_tags()
                    existentes = {t["nome"] for t in atuais}
                    gravar(".tags.json", json.dumps(atuais + [t for t in tags if t["nome"] not in existentes],
                                                    ensure_ascii=False, indent=2).encode("utf-8"))
            if ".pensamentos.json" in conteudos:
                with contextlib.suppress(ValueError, UnicodeDecodeError):
                    do_backup = json.loads(conteudos[".pensamentos.json"][0].decode("utf-8"))
                    atual = {}
                    with contextlib.suppress(OSError, ValueError, CofreError):
                        atual = json.loads(self.armazem.ler(".pensamentos.json").decode("utf-8"))
                    gravar(".pensamentos.json", json.dumps(mesclar_pensamentos(atual, do_backup),
                                                           ensure_ascii=False, indent=2).encode("utf-8"))
        except BaseException:
            for rel, dados in anteriores.items():
                with contextlib.suppress(Exception):
                    self.armazem.gravar(rel, dados)
            for rel in novos:
                with contextlib.suppress(Exception):
                    self.armazem.apagar(rel)
            raise
        n = sum(1 for rel in conteudos if rel not in EXTRAS)
        return n, ignorados, copia


LEIA_ME_BACKUP_CIFRADO = """Backup cifrado do app MyNotes.

Os registros estão em cofre/*.bin, cifrados (XChaCha20-Poly1305); a chave fica no
cofre.json, protegida pela senha (Argon2id) que o cofre tinha quando este backup foi feito.
Para restaurar: no MyNotes, menu ☰ → Restaurar backup…
Sem a senha (ou a chave de recuperação) da época, não há como ler este backup.
"""


# ======================================================================
# Migração: da pasta comum (Markdown legível) para o cofre
# ======================================================================
def levantar_texto_puro(pasta):
    """O que existe em texto puro na pasta: registros (com lixeira, tags e pensamentos) e
    cópias (.zip de backups antigos, cópia da migração, temporários esquecidos)."""
    pasta = Path(pasta)
    registros: dict[str, Path] = {}
    for padrao in ("*.md", "diario/*.md", "exames/*.md", ".lixeira/*/*.md", *EXTRAS):
        for p in sorted(pasta.glob(padrao)):
            rel = p.relative_to(pasta).as_posix()
            if p.is_file() and RE_REL.match(rel):
                registros[rel] = p
    copias = []
    for sub in (".seguranca", DIR_MIGRACAO):
        for p in sorted((pasta / sub).glob("*.zip")):
            with contextlib.suppress(OSError, zipfile.BadZipFile):
                with zipfile.ZipFile(p) as z:
                    if "cofre.json" in z.namelist():
                        continue            # backup cifrado: não é texto puro
            copias.append(p)
    for padrao in (".*.tmp", "diario/.*.tmp", "exames/.*.tmp", ".lixeira/*/.*.tmp", ".seguranca/.*.tmp"):
        copias += [p for p in sorted(pasta.glob(padrao)) if p.is_file()]
    return {"registros": registros, "copias": copias}


def resumo_texto_puro(achados):
    """Contagem por tipo, para mostrar antes da migração."""
    r = {"nota": 0, "diario": 0, "exame": 0, "lixeira": 0, "auxiliares": 0}
    for rel in achados["registros"]:
        if rel.startswith(".lixeira/"):
            r["lixeira"] += 1
        elif rel in EXTRAS:
            r["auxiliares"] += 1
        elif rel.startswith("diario/"):
            r["diario"] += 1
        elif rel.startswith("exames/"):
            r["exame"] += 1
        else:
            r["nota"] += 1
    return r


def _so_cifrados(d: Path):
    """A pasta só tem o que uma migração interrompida deixa (arquivos cifrados)?"""
    for p in d.rglob("*"):
        if p.is_file() and not (p.suffix == ".bin" or p.name == ARQ_COFRE or p.name.endswith(".tmp")):
            return False
    return True


def limpar_tentativa(pasta):
    """Apaga o que sobrou de uma migração interrompida (só dados cifrados, nunca originais)."""
    pasta = Path(pasta)
    for d in (pasta / DIR_COFRE_NOVO, pasta / DIR_COFRE):
        if d == pasta / DIR_COFRE and cofre_existe(pasta):
            continue
        if d.is_dir():
            if not _so_cifrados(d):
                raise CofreError(f"A pasta {d} tem arquivos inesperados; confira e apague-a à mão.")
            shutil.rmtree(d)


def _conferir_cofre(pasta_cab, dir_blobs, senha, originais):
    chave = abrir_cofre(pasta_cab, senha)
    arm = ArmazemCofre(pasta_cab, chave, dir_blobs=dir_blobs)
    if arm.erros:
        raise CofreDanificado("; ".join(arm.erros[:3]))
    if set(arm.todos()) != set(originais):
        raise CofreDanificado("o número de registros no cofre não confere com o dos originais")
    for rel, (dados, _m) in originais.items():
        if arm.ler(rel) != dados:
            raise CofreDanificado(f"o conteúdo de {rel} não confere com o original")
    arm.fechar()
    return len(originais)


def migrar_para_cofre(pasta, senha, ops=None, mem=None, ao_progresso=None, _falhar_apos=None):
    """Cria o cofre a partir dos arquivos em texto puro, SEM apagar nem alterar os originais.
    1. lê tudo; 2. guarda uma cópia (.zip) em .migracao/; 3. cifra tudo numa pasta
    temporária; 4. abre de novo pela senha e compara cada arquivo com o original;
    5. efetiva (o cofre.json é gravado por último: sem ele, nada mudou); 6. confere de novo.
    Se algo falhar antes do passo 5, os originais continuam como estavam e o que foi cifrado
    é descartado. Devolve um resumo."""
    exigir_nacl()
    pasta = Path(pasta)
    aviso = ao_progresso or (lambda _t: None)
    if cofre_existe(pasta):
        raise CofreError("Já existe um cofre nesta pasta.")
    if avaliar_senha(senha, False) and avaliar_senha(senha, True):
        raise CofreError("Senha fraca demais.")
    achados = levantar_texto_puro(pasta)
    aviso("Lendo os registros…")
    originais = {}
    for rel, p in achados["registros"].items():
        originais[rel] = (p.read_bytes(), p.stat().st_mtime_ns)
    copia = None
    if originais:
        aviso("Fazendo a cópia de segurança…")
        criar_pasta(pasta / DIR_MIGRACAO)
        proteger(pasta / DIR_MIGRACAO, 0o700)
        copia = pasta / DIR_MIGRACAO / f"antes-da-migracao-{datetime.now():%Y-%m-%d-%H%M%S}.zip"
        with zipfile.ZipFile(copia, "w", zipfile.ZIP_DEFLATED) as z:
            for rel, (dados, mtime) in originais.items():
                info = zipfile.ZipInfo(rel, datetime.fromtimestamp(mtime / 1e9).timetuple()[:6])
                info.compress_type = zipfile.ZIP_DEFLATED
                z.writestr(info, dados)
        os.chmod(copia, 0o600)
        with zipfile.ZipFile(copia) as z:
            if z.testzip() is not None or len(z.namelist()) != len(originais):
                raise OSError(errno.EIO, "a cópia de segurança da migração ficou incompleta")
    limpar_tentativa(pasta)
    novo = pasta / DIR_COFRE_NOVO
    try:
        aviso("Criando a chave (Argon2id)…")
        chave = nacl.utils.random(32)
        cab = novo_cabecalho(chave, senha, ops, mem)
        criar_pasta(novo / DIR_COFRE)
        arm = ArmazemCofre(pasta, chave, dir_blobs=novo / DIR_COFRE, carregar=False)
        for i, (rel, (dados, mtime)) in enumerate(originais.items()):
            if _falhar_apos is not None and i >= _falhar_apos:
                raise OSError(errno.EIO, "falha simulada no meio da migração")
            aviso(f"Cifrando {i + 1} de {len(originais)}…")
            arm.gravar(rel, dados, mtime)
        arm.fechar()
        gravar_cabecalho(novo, cab)
        aviso("Conferindo o cofre com a senha…")
        _conferir_cofre(novo, novo / DIR_COFRE, senha, originais)
    except BaseException:
        with contextlib.suppress(OSError):
            shutil.rmtree(novo)
        raise
    # efetiva: primeiro a pasta dos arquivos cifrados, por último o cofre.json
    os.rename(novo / DIR_COFRE, pasta / DIR_COFRE)
    os.rename(novo / ARQ_COFRE, pasta / ARQ_COFRE)
    with contextlib.suppress(OSError):
        dfd = os.open(pasta, os.O_RDONLY)
        try:
            os.fsync(dfd)
        finally:
            os.close(dfd)
    with contextlib.suppress(OSError):
        shutil.rmtree(novo)
    try:
        aviso("Desbloqueando o cofre novo para conferir…")
        n = _conferir_cofre(pasta, pasta / DIR_COFRE, senha, originais)
    except BaseException:
        # desfaz a efetivação: sem cofre.json, o app volta a usar os originais
        criar_pasta(novo)
        with contextlib.suppress(OSError):
            os.rename(pasta / ARQ_COFRE, novo / ARQ_COFRE)
        with contextlib.suppress(OSError):
            os.rename(pasta / DIR_COFRE, novo / DIR_COFRE)
        raise
    return {"total": n, "por_tipo": resumo_texto_puro(achados), "copia": copia,
            "originais": sorted(achados["registros"].values()), "copias": achados["copias"]}


def remover_texto_puro(pasta, armazem, incluir_copias=False):
    """Apaga os originais em texto puro que estão no cofre com conteúdo idêntico.
    O que não confere (ou as cópias .zip, sem incluir_copias) fica onde está.
    Devolve (removidos, mantidos[(caminho, motivo)])."""
    pasta = Path(pasta)
    achados = levantar_texto_puro(pasta)
    removidos, mantidos = [], []
    for rel, p in achados["registros"].items():
        try:
            igual = armazem.existe(rel) and armazem.ler(rel) == p.read_bytes()
        except (OSError, CofreError):
            igual = False
        if igual:
            p.unlink()
            removidos.append(p)
        else:
            mantidos.append((p, "não está no cofre com este mesmo conteúdo"))
    for p in achados["copias"]:
        if incluir_copias:
            p.unlink()
            removidos.append(p)
        else:
            mantidos.append((p, "cópia de segurança em texto puro (você escolheu manter)"))
    for sub in (".lixeira/notas", ".lixeira/diario", ".lixeira/exames", ".lixeira/conflitos",
                ".lixeira", "diario", "exames", DIR_MIGRACAO):
        with contextlib.suppress(OSError):
            (pasta / sub).rmdir()          # só some se estiver vazia
    return removidos, mantidos


