    def em_segundo_plano(self, trabalho, fim):
        """Roda `trabalho()` numa thread (derivar a chave leva ~2 s) e chama fim(resultado, erro)
        de volta na interface. Enquanto isso, nenhum atalho age sobre os dados."""
        self.ocupado = True

        def rodar():
            try:
                res, err = trabalho(), None
            except Exception as e:      # noqa: BLE001 — o erro é mostrado na interface
                res, err = None, e

            def voltar():
                self.ocupado = False
                fim(res, err)
                return False
            GLib.idle_add(voltar, priority=GLib.PRIORITY_DEFAULT)   # não esperar as animações
        threading.Thread(target=rodar, daemon=True).start()

    def campos_senha(self, ao_mudar):
        """Escolha da senha: completa ou numérica, repetição, mostrar/ocultar.
        Devolve (widget, obter) — obter() -> (senha ou None, problema)."""
        modo = Adw.ToggleGroup(css_classes=["modos"], homogeneous=True)
        modo.add(Adw.Toggle(name="completa", label="Senha completa (recomendada)"))
        modo.add(Adw.Toggle(name="numerica", label="Só números"))
        modo.set_active_name("completa")
        explicacao = Gtk.Label(xalign=0, wrap=True, css_classes=["prosa-pequena"])
        e1 = Gtk.PasswordEntry(show_peek_icon=True, placeholder_text="Senha", hexpand=True)
        e2 = Gtk.PasswordEntry(show_peek_icon=True, placeholder_text="Repita a senha", hexpand=True)
        situacao = Gtk.Label(xalign=0, wrap=True, css_classes=["dica"])
        guarde = Gtk.Label(
            xalign=0, wrap=True, css_classes=["dica"],
            label="Guarde a senha num lugar seguro (um gerenciador de senhas, ou anotada em papel "
                  "guardado longe do computador). O app não a grava em lugar nenhum e não tem como "
                  "recuperá-la.")
        textos = {
            "completa": f"Letras, números, espaços e símbolos, como preferir: não há regra de "
                        f"“uma maiúscula e um símbolo”. Mínimo de {MIN_SENHA} caracteres, porque "
                        "os arquivos cifrados podem ser atacados fora do app, sem limite de "
                        "tentativas, e cada caractere a mais multiplica o trabalho de quem tenta "
                        "adivinhar. Uma frase de 4 ou 5 palavras sem relação entre si é longa e "
                        "fácil de lembrar.",
            "numerica": f"Só dígitos, no mínimo {MIN_SENHA}. Atenção: mesmo longa, uma senha só de "
                        "números tem bem menos combinações (10 por posição, contra mais de 90 numa "
                        "senha completa) e resiste menos a ataques de força bruta. Não equivale a "
                        "uma senha forte.",
        }

        def obter():
            s1, s2 = e1.get_text(), e2.get_text()
            problema = avaliar_senha(s1, modo.get_active_name() == "numerica")
            if problema:
                return None, problema
            if s1 != s2:
                return None, "As duas senhas não são iguais." if s2 else "Repita a senha no segundo campo."
            return s1, None

        def atualizar(*_):
            explicacao.set_label(textos[modo.get_active_name()])
            senha, problema = obter()
            if not e1.get_text():
                situacao.set_label("")
            else:
                situacao.set_label("󰄬 Senha aceita." if senha else f"󰀦 {problema}")
            if pronto:
                ao_mudar()
        pronto = False
        for w in (e1, e2):
            w.connect("changed", atualizar)
        modo.connect("notify::active-name", atualizar)
        atualizar()
        pronto = True
        caixa = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        for w in (modo, explicacao, e1, e2, situacao, guarde):
            caixa.append(w)
        caixa.e1, caixa.e2, caixa.modo = e1, e2, modo
        return caixa, obter

