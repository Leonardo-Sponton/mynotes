# ======================================================================
# Cofre: criptografia com PyNaCl (libsodium)
#   chave do cofre: 32 bytes aleatórios; cada arquivo é cifrado com ela
#   (XChaCha20-Poly1305, nonce aleatório de 24 bytes, id do arquivo como dado associado).
#   A chave do cofre fica em "envelopes" no cofre.json: cifrada com uma chave derivada da
#   senha (Argon2id, salt próprio) e, se você quiser, com uma chave de recuperação.
# ======================================================================
try:
    import nacl.bindings as sodium
    import nacl.exceptions
    import nacl.pwhash
    import nacl.utils
except ImportError:      # o app funciona sem o cofre enquanto o pacote não estiver instalado
    sodium = None

ARQ_COFRE = "cofre.json"
DIR_COFRE = "cofre"
DIR_COFRE_NOVO = ".cofre-novo"      # usado só durante a migração
DIR_MIGRACAO = ".migracao"
COFRE_VERSAO = 1
# Argon2id com os parâmetros "SENSITIVE" do libsodium: 4 passagens, 1 GiB de memória
# (cerca de 1–2 s por tentativa num notebook comum). Ficam gravados no cofre.json.
KDF_OPS = 4
KDF_MEM = 1 << 30
MAGICO = b"IDC1"
AAD = b"mynotes-cofre/1/"
BLOCO_PAD = 512          # o tamanho cifrado só revela o tamanho em blocos de 512 bytes
MIN_SENHA = 12
RE_ID = re.compile(r"^[0-9a-f]{32}$")
PACOTE_NACL = "python-pynacl"


class CofreError(Exception):
    pass


class SenhaIncorreta(CofreError):
    pass


class CofreDanificado(CofreError):
    pass


class PrecisaSenha(CofreError):
    """O backup foi feito com outra chave: é preciso a senha que ele tinha."""


def tem_criptografia():
    return sodium is not None


def exigir_nacl():
    if sodium is None:
        raise CofreError(f"A criptografia precisa do pacote {PACOTE_NACL} "
                         f"(instale com: sudo pacman -S {PACOTE_NACL}).")


def b64(b: bytes) -> str:
    return base64.b64encode(b).decode("ascii")


def de_b64(s) -> bytes:
    try:
        return base64.b64decode(s, validate=True)
    except (ValueError, TypeError):
        raise CofreDanificado("valor inválido no cofre.json") from None


def derivar(segredo: str, salt: bytes, ops: int, mem: int) -> bytes:
    """Argon2id. A senha é normalizada (NFC) para que "é" digitado de jeitos diferentes valha igual."""
    exigir_nacl()
    if not (1 <= ops <= 20 and 8 << 20 <= mem <= 4 << 30):
        raise CofreDanificado("parâmetros de derivação fora do esperado")
    dados = unicodedata.normalize("NFC", segredo).encode("utf-8")
    return nacl.pwhash.argon2id.kdf(32, dados, salt, opslimit=ops, memlimit=mem)


def cifrar(chave: bytes, dados: bytes, contexto: bytes) -> bytes:
    nonce = nacl.utils.random(24)
    return MAGICO + nonce + sodium.crypto_aead_xchacha20poly1305_ietf_encrypt(
        dados, AAD + contexto, nonce, chave)


def decifrar(chave: bytes, blob: bytes, contexto: bytes) -> bytes:
    """Confere a autenticidade antes de devolver qualquer coisa (senão: CofreDanificado)."""
    if len(blob) < 4 + 24 + 16 or not blob.startswith(MAGICO):
        raise CofreDanificado("formato desconhecido")
    try:
        return sodium.crypto_aead_xchacha20poly1305_ietf_decrypt(
            blob[28:], AAD + contexto, blob[4:28], chave)
    except nacl.exceptions.CryptoError:
        raise CofreDanificado("falha na verificação de autenticidade") from None


def criar_envelope(chave, tipo, segredo, ops=None, mem=None):
    exigir_nacl()
    ops, mem = ops or KDF_OPS, mem or KDF_MEM
    salt = nacl.utils.random(nacl.pwhash.argon2id.SALTBYTES)
    kek = derivar(segredo, salt, ops, mem)
    return {"kdf": "argon2id", "salt": b64(salt), "ops": ops, "mem": mem,
            "chave": b64(cifrar(kek, chave, b"envelope/" + tipo.encode()))}


def abrir_envelope(env, tipo, segredo) -> bytes:
    try:
        salt, ops, mem, blob = de_b64(env["salt"]), int(env["ops"]), int(env["mem"]), de_b64(env["chave"])
    except (KeyError, TypeError, ValueError):
        raise CofreDanificado("envelope inválido no cofre.json") from None
    kek = derivar(segredo, salt, ops, mem)
    try:
        chave = decifrar(kek, blob, b"envelope/" + tipo.encode())
    except CofreDanificado:
        raise SenhaIncorreta() from None
    if len(chave) != 32:
        raise CofreDanificado("chave do cofre com tamanho errado")
    return chave


def novo_cabecalho(chave, senha, ops=None, mem=None):
    return {"formato": "mynotes-cofre", "versao": COFRE_VERSAO,
            "cifra": "xchacha20poly1305-ietf", "padding": BLOCO_PAD,
            "envelopes": {"senha": criar_envelope(chave, "senha", senha, ops, mem)}}


def validar_cabecalho(cab):
    if not (isinstance(cab, dict) and cab.get("formato") == "mynotes-cofre"
            and isinstance(cab.get("envelopes"), dict) and "senha" in cab["envelopes"]):
        raise CofreDanificado("cofre.json inválido")
    if cab.get("versao") != COFRE_VERSAO:
        raise CofreError(f"Este cofre usa o formato {cab.get('versao')}, que esta versão do app "
                         "não conhece.")
    return cab


def ler_cabecalho(pasta) -> dict:
    try:
        return validar_cabecalho(json.loads((Path(pasta) / ARQ_COFRE).read_text(encoding="utf-8")))
    except (ValueError, UnicodeDecodeError):
        raise CofreDanificado("cofre.json ilegível") from None


def gravar_cabecalho(pasta, cab):
    escrever_atomico(Path(pasta) / ARQ_COFRE, json.dumps(cab, indent=2) + "\n")


def cofre_existe(pasta) -> bool:
    return (Path(pasta) / ARQ_COFRE).exists()


def abrir_cofre(pasta, segredo, tipo="senha") -> bytes:
    """Devolve a chave do cofre (ou SenhaIncorreta). tipo: "senha" ou "recuperacao"."""
    cab = ler_cabecalho(pasta)
    env = cab["envelopes"].get(tipo)
    if env is None:
        raise SenhaIncorreta()
    return abrir_envelope(env, tipo, segredo)


def trocar_senha(pasta, chave, nova, ops=None, mem=None):
    """Troca o envelope da senha (os registros não precisam ser cifrados de novo) e confere
    que a nova senha abre o cofre gravado no disco."""
    cab = ler_cabecalho(pasta)
    cab["envelopes"]["senha"] = criar_envelope(chave, "senha", nova, ops, mem)
    gravar_cabecalho(pasta, cab)
    if abrir_cofre(pasta, nova) != chave:
        raise CofreDanificado("a nova senha não abriu o cofre gravado")


ALFABETO_REC = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789"      # sem 0/O e 1/I, fáceis de confundir


def gerar_codigo_recuperacao():
    """25 símbolos de 32 possíveis = 125 bits aleatórios, em grupos de 5."""
    import secrets
    s = "".join(secrets.choice(ALFABETO_REC) for _ in range(25))
    return "-".join(s[i:i + 5] for i in range(0, 25, 5))


def normalizar_codigo(codigo):
    return "".join(c for c in codigo.upper() if c in ALFABETO_REC)


def criar_recuperacao(pasta, chave, ops=None, mem=None):
    codigo = gerar_codigo_recuperacao()
    cab = ler_cabecalho(pasta)
    cab["envelopes"]["recuperacao"] = criar_envelope(chave, "recuperacao", normalizar_codigo(codigo),
                                                     ops, mem)
    gravar_cabecalho(pasta, cab)
    if abrir_cofre(pasta, normalizar_codigo(codigo), "recuperacao") != chave:
        raise CofreDanificado("a chave de recuperação não abriu o cofre gravado")
    return codigo


def remover_recuperacao(pasta):
    cab = ler_cabecalho(pasta)
    cab["envelopes"].pop("recuperacao", None)
    gravar_cabecalho(pasta, cab)


def tem_recuperacao(pasta):
    with contextlib.suppress(CofreError, OSError):
        return "recuperacao" in ler_cabecalho(pasta)["envelopes"]
    return False


def _senha_trivial(s):
    if len(set(s)) <= 2:
        return True
    for p in range(1, 5):                    # repetição de um pedaço curto: 123123123123
        if s == (s[:p] * (len(s) // p + 1))[:len(s)]:
            return True
    passos = {(ord(b) - ord(a)) % 10 if s.isdigit() else ord(b) - ord(a) for a, b in zip(s, s[1:])}
    return len(passos) == 1 and passos <= {1, 9, -1}     # sequência: 1234…, 9876…, abcd…


def avaliar_senha(senha, numerica: bool):
    """Devolve None se a senha pode ser usada, ou a explicação do problema."""
    if numerica:
        if not re.fullmatch(r"[0-9]+", senha):
            return "A senha numérica só pode ter números (0–9)."
        if len(senha) < MIN_SENHA:
            return f"Use pelo menos {MIN_SENHA} dígitos (faltam {MIN_SENHA - len(senha)})."
    else:
        if len(senha) < MIN_SENHA:
            return f"Use pelo menos {MIN_SENHA} caracteres (faltam {MIN_SENHA - len(senha)})."
        if not senha.strip():
            return "A senha não pode ser só espaços."
    if _senha_trivial(senha):
        return "Essa senha é fácil de adivinhar (repetição ou sequência). Escolha outra."
    return None


def _empacotar(rel, dados, modificado_ns):
    meta = json.dumps({"rel": rel, "mod": modificado_ns}, ensure_ascii=False).encode("utf-8")
    return sodium.sodium_pad(meta + b"\n" + dados, BLOCO_PAD)


def _desempacotar(bruto):
    try:
        meta, _, dados = sodium.sodium_unpad(bruto, BLOCO_PAD).partition(b"\n")
        m = json.loads(meta.decode("utf-8"))
        rel = m["rel"]
    except (ValueError, KeyError, TypeError, UnicodeDecodeError, nacl.exceptions.CryptoError):
        raise CofreDanificado("conteúdo decifrado em formato inesperado") from None
    if not isinstance(rel, str) or not RE_REL.match(rel):
        raise CofreDanificado("caminho inválido dentro do cofre")
    mod = m.get("mod")
    return rel, dados, mod if isinstance(mod, int) else None


