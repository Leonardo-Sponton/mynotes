    def on_favorito(self, bt):
        p = self.pens_atual
        if self.carregando or p is None or self.biblioteca is None:
            return
        try:
            self.biblioteca.favoritar(p["id"], bt.get_active())
        except OSError as e:
            self.avisar(f"Não foi possível salvar: {e.strerror or e}")
        self.mostrar_pensamento_biblioteca(p)
        if self.modo == "pensamento":
