    def selecionar_linha_pensamento(self, p):
        self.carregando = True
        i = 0
        alvo = None
        while (row := self.lista.get_row_at_index(i)) is not None:
            if getattr(row, "pensamento", None) is p:
                alvo = row
                break
            i += 1
        if alvo:
            self.lista.select_row(alvo)
        else:
            self.lista.unselect_all()
        self.carregando = False

    def pensamentos_visiveis(self):
        b = self.biblioteca
        if b is None:
            return []

        def escolhido(dd):
            item = dd.get_selected_item()
            return item.get_string() if dd.get_selected() > 0 and item else None
        origem_idx = self.dd_origem.get_selected()
        return b.filtrar(self.busca.get_text(), autor=escolhido(self.dd_autor),
                         tradicao=escolhido(self.dd_tradicao), tema=escolhido(self.dd_tema),
                         origem={1: "app", 2: "usuario"}.get(origem_idx),
                         classificacao="incerta" if origem_idx == 3 else None,
                         so_favoritos=self.bt_so_favoritos.get_active())

    def atualizar_filtros_pensamento(self):
        b = self.biblioteca
        if b is None:
            return
        self.carregando_filtros = True
        for dd, primeiro, valores in ((self.dd_autor, "Todos os autores", b.autores()),
                                      (self.dd_tradicao, "Todas as tradições", b.tradicoes()),
                                      (self.dd_tema, "Todos os temas", b.temas())):
            modelo = dd.get_model()
            itens = [primeiro, *valores]
            if [modelo.get_string(i) for i in range(modelo.get_n_items())] == itens:
                continue
            item = dd.get_selected_item()
            atual = item.get_string() if item and dd.get_selected() > 0 else None
            dd.set_model(Gtk.StringList.new(itens))
            dd.set_selected(itens.index(atual) if atual in itens else 0)
        self.carregando_filtros = False

