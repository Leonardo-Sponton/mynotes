            bt_cancelar.set_visible(nome in ("intro", "senha", "fim"))
            bt_cancelar.set_label("Fechar" if nome == "fim" else "Cancelar")
        bt_continuar.connect("clicked", lambda *_: (ir("senha"), campos.e1.grab_focus()))

        def criar(*_):
