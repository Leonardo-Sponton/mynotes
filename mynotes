    def aplicar_fechamento(self, d: date, como_foi, aprendi, propositos):
        """Cada resposta vai para um só lugar: 1 e 2 para o diário do dia, 3 para o exame."""
        como_foi, aprendi, propositos = como_foi.strip(), aprendi.strip(), propositos.strip()
        if not (como_foi or aprendi or propositos):
            return []
        self.salvar_agora()
        tocados = []
        if como_foi or aprendi:
            diario = self.registro_do_dia("diario", d)
            if como_foi:
                diario.texto = acrescentar_em_secao(diario.texto, None, como_foi)
            if aprendi:
                diario.texto = acrescentar_em_secao(diario.texto, "Aprendizados", aprendi)
            tocados.append(diario)
        if propositos:
            exame = self.registro_do_dia("exame", d)
            livre, conhecidas, extras = dividir_secoes(exame.texto)
            antes = conhecidas.get("propositos", "").strip("\n")
            conhecidas["propositos"] = f"{antes}\n\n{propositos}" if antes.strip() else propositos
            exame.texto = juntar_secoes(livre, conhecidas, extras)
            tocados.append(exame)
        self.pendentes.update(tocados)
        self.salvar_agora()
        if self.atual in tocados:
            self.mostrar(self.atual, forcar=True)
        self.recarregar_lista()
        self.marcar_calendario()
        self.aplicar_visibilidade()
        if any(r in self.pendentes for r in tocados):
            self.avisar("Não foi possível salvar o fechamento; o texto ficou no app. "
                        "Veja o aviso “Falha ao salvar”.")
        else:
            self.avisar(f"Fechamento salvo no {' e no '.join(TIPOS[r.tipo][1] for r in tocados)} "
                        f"de {d:%d/%m}.")
        return tocados

