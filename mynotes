    # ------------------------------------------------------------------
    # áreas e navegação
    # ------------------------------------------------------------------
    def buscando(self):
        """Busca global nos registros (na área Pensamentos, o campo filtra a biblioteca)."""
        return self.modo != "pensamento" and bool(self.busca.get_text().strip())

    def on_modo(self, grupo, _p):
        nome = grupo.get_active_name()
        if self.trocando_modo or not nome or nome == self.modo:
            return
        self.salvar_agora()
        self.ultimo[self.modo] = self.atual
        self.modo = nome
        if self.buscando():
            self.busca.set_text("")
        self.aplicar_modo()
        if nome == "nota":
            alvo = self.ultimo.get("nota")
            self.mostrar(alvo if alvo in self.registros["nota"] else None)
            self.recarregar_lista()
        elif nome == "pensamento":
            self.mostrar(None)
            self.recarregar_lista()
            alvo = self.pens_atual and self.biblioteca and self.biblioteca.por_id(self.pens_atual["id"])
            if alvo:
                self.mostrar_pensamento_biblioteca(alvo)
            else:
                self.abrir_pensamento_do_dia()
        else:
            self.abrir_dia(self.datas[nome])

    def trocar_modo_visual(self, tipo):
        """Muda a área mostrada sem reabrir nada (usado ao abrir um resultado de busca)."""
        if tipo == self.modo:
            return
        self.ultimo[self.modo] = self.atual
        self.trocando_modo = True
        self.modos.set_active_name(tipo)
        self.trocando_modo = False
        self.modo = tipo
        self.aplicar_modo()

    def aplicar_modo(self):
        pens = self.modo == "pensamento"
        buscando = self.buscando()
        self.area_busca.set_visible(buscando)
        self.area_notas.set_visible(self.modo == "nota" and not buscando)
        self.area_datas.set_visible(self.modo in ("diario", "exame") and not buscando)
        self.area_pensamentos.set_visible(pens)
        self.busca.set_placeholder_text("Buscar pensamentos (texto, autor, obra, tema)…" if pens
                                        else "Buscar em tudo…")
        self.busca.set_tooltip_text("Filtra a biblioteca de pensamentos" if pens else
                                    "Busca no título, no texto e nas tags das três áreas (Ctrl+F)")
        if pens:
            self.atualizar_filtros_pensamento()
            self.lista_vazia.set_label("Nenhum pensamento com estes filtros.")
        elif buscando:
            self.rotulo_lista.set_label("RESULTADOS")
            self.lista_vazia.set_label("Nada encontrado.\nTente outra palavra ou mude os filtros.")
        elif self.modo == "nota":
            self.rotulo_lista.set_label("NOTAS")
            self.lista_vazia.set_label("Nenhuma nota com estes filtros.")
        elif self.modo == "diario":
            self.rotulo_lista.set_label("DIÁRIO · HISTÓRICO")
            self.lista_vazia.set_label("Ainda não há entradas.\nEscreva no dia de hoje ao lado; "
                                       "os dias com registro ficam destacados no calendário.")
        else:
            self.rotulo_lista.set_label("EXAMES ANTERIORES")
            self.lista_vazia.set_label("Ainda não há exames.\nPreencha o de hoje ao lado, "
                                       "só as seções que fizerem sentido.")
        for tipo in ("diario", "exame"):
            if tipo == self.modo:
                self.calendario.add_css_class(tipo)
            else:
                self.calendario.remove_css_class(tipo)
        self.vazio.set_title("Nenhuma nota aqui" if self.modo == "nota" else "Nada selecionado")
        self.vazio.set_description("Clique em “Nova nota” (Ctrl+N) para anotar algo."
                                   if self.modo == "nota" else "")
        self.sincronizar_calendario()

    def on_busca(self):
        self.aplicar_modo()
        self.recarregar_lista()

    def registro_do_dia(self, tipo, d: date) -> Registro:
        rel = self.repo.rel_do_dia(tipo, d)
        candidatos = [*self.registros[tipo], *self.pendentes]
        if self.atual is not None:
            candidatos.append(self.atual)
        for r in candidatos:
            if r.tipo == tipo and r.rel == rel:
                return r
        r = self.repo.registro(rel, tipo)
        if r.existe():          # criado fora do app depois que a lista foi lida
            self.adicionar_registro(r)
        return r

    def abrir_dia(self, d: date):
        tipo = self.modo if self.modo in ("diario", "exame") else "diario"
        if tipo != self.modo:
            self.trocar_modo_visual(tipo)
        self.datas[tipo] = d
        self.mostrar(self.registro_do_dia(tipo, d))
        self.recarregar_lista()

    def dia_relativo(self, delta):
        if self.modo in ("diario", "exame"):
            self.abrir_dia(self.datas[self.modo] + timedelta(days=delta))

    def abrir_outro_do_dia(self):
        """Do diário para o exame do mesmo dia, e vice-versa (nada é copiado)."""
        if self.modo not in ("diario", "exame"):
            return
        d = self.datas[self.modo]
        self.salvar_agora()
        outro = "exame" if self.modo == "diario" else "diario"
        self.trocar_modo_visual(outro)
        self.abrir_dia(d)
        self.focar_corpo()

    def sincronizar_calendario(self):
        if self.modo not in ("diario", "exame"):
            return
        d = self.datas[self.modo]
        self.ajustando_cal = True
        dt = GLib.DateTime.new_local(d.year, d.month, d.day, 12, 0, 0)
        if hasattr(self.calendario, "set_date"):
            self.calendario.set_date(dt)
        else:
            self.calendario.select_day(dt)
        self.ajustando_cal = False
        self.marcar_calendario()

    def marcar_calendario(self):
        if self.modo not in ("diario", "exame"):
            return
        cal = self.calendario
        cal.clear_marks()
        ano, mes = cal.props.year, cal.props.month + 1
        for r in self.registros[self.modo]:
            d = r.data()
            if d.year == ano and d.month == mes:
                cal.mark_day(d.day)

    def on_dia_calendario(self, cal):
        if self.ajustando_cal or self.modo not in ("diario", "exame"):
            return
        dt = cal.get_date()
        d = date(dt.get_year(), dt.get_month(), dt.get_day_of_month())
        if d != self.datas[self.modo] or self.atual is None:
            self.abrir_dia(d)

    # ------------------------------------------------------------------
    # tags
    # ------------------------------------------------------------------
    def cor_da_tag(self, nome):
        for t in self.tags:
            if t["nome"] == nome:
                return t.get("cor", "cinza")
        return "cinza"

    def chip(self, nome, ao_clicar=None, ao_remover=None, ativo=False):
        cor = f"cor-{self.cor_da_tag(nome)}"
        if ao_clicar:
            bt = Gtk.ToggleButton(label=f"#{nome}", active=ativo, css_classes=["tag", cor],
                                  tooltip_text=f"Mostrar só as notas com #{nome}")
            bt.connect("clicked", lambda *_: ao_clicar(nome))
            return bt
        box = Gtk.Box(css_classes=["tag", cor], valign=Gtk.Align.CENTER)
        box.append(Gtk.Label(label=f"#{nome}"))
        if ao_remover:
            x = Gtk.Button(label="✕", css_classes=["tag-x"], tooltip_text="Tirar tag")
            x.connect("clicked", lambda *_: ao_remover(nome))
            box.append(x)
        return box

    def atualizar_filtro_tags(self):
        self.caixa_filtro_tags.remove_all()
        for t in self.tags:
            self.caixa_filtro_tags.append(
                self.chip(t["nome"], ao_clicar=self.on_filtro_tag, ativo=t["nome"] == self.filtro_tag))

    def on_filtro_tag(self, nome):
        self.filtro_tag = None if self.filtro_tag == nome else nome
        self.atualizar_filtro_tags()
        self.recarregar_lista()

    def atualizar_tags_registro(self):
        self.caixa_tags.remove_all()
        if not self.atual or self.atual.tipo != "nota":
            return
        for nome in self.atual.tags:
            self.caixa_tags.append(self.chip(nome, ao_remover=self.tirar_tag))
        mais = Gtk.MenuButton(icon_name="list-add-symbolic", tooltip_text="Adicionar tag",
                              css_classes=["flat"], valign=Gtk.Align.CENTER)
        mais.set_create_popup_func(self.montar_popover_tags)
        self.caixa_tags.append(mais)

    def montar_popover_tags(self, menubutton):
        caixa = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4,
                        margin_start=8, margin_end=8, margin_top=8, margin_bottom=8)
        for t in self.tags:
            cb = Gtk.CheckButton(label=f"#{t['nome']}", active=t["nome"] in self.atual.tags)
            cb.add_css_class(f"cor-{t.get('cor', 'cinza')}")
            cb.connect("toggled", lambda b, n=t["nome"]: self.alternar_tag(n, b.get_active()))
            caixa.append(cb)
        nova = Gtk.Entry(placeholder_text="Nova tag + Enter", margin_top=6)
        nova.connect("activate", lambda e: self.criar_tag_rapida(e, menubutton))
        caixa.append(nova)
        gerenciar = Gtk.Button(label="Gerenciar tags…", css_classes=["flat"])
        gerenciar.connect("clicked", lambda *_: (menubutton.popdown(), self.gerenciar_tags()))
        caixa.append(gerenciar)
        menubutton.set_popover(Gtk.Popover(child=caixa))

    def alternar_tag(self, nome, ligar):
        r = self.atual
        if r is None:
            return
        if ligar and nome not in r.tags:
            r.tags.append(nome)
        elif not ligar and nome in r.tags:
            r.tags.remove(nome)
        self.marcar_alterado(r)
        self.salvar_agora()
        GLib.idle_add(self.atualizar_tags_registro)

    def tirar_tag(self, nome):
        self.alternar_tag(nome, False)

    def gravar_tags(self):
        try:
            self.repo.salvar_tags(self.tags)
        except OSError as e:
            self.avisar(f"Não foi possível salvar as tags: {e.strerror or e}")

    def criar_tag_rapida(self, entry, menubutton):
        nome = entry.get_text().strip().lstrip("#").replace(",", " ")
        if not nome:
            return
        if not any(t["nome"] == nome for t in self.tags):
            cores = list(CORES_TAG)
            self.tags.append({"nome": nome, "cor": cores[len(self.tags) % len(cores)]})
            self.gravar_tags()
            self.atualizar_filtro_tags()
        menubutton.popdown()
        self.alternar_tag(nome, True)

    def gerenciar_tags(self):
        dialogo = Adw.Dialog(title="Tags", content_width=440, content_height=520)
        lista = Gtk.ListBox(css_classes=["boxed-list"], selection_mode=Gtk.SelectionMode.NONE)

        def recarregar():
            lista.remove_all()
            for t in self.tags:
                linha = Gtk.Box(spacing=10, margin_start=10, margin_end=6, margin_top=6, margin_bottom=6)
                linha.append(self.chip(t["nome"]))
                usos = sum(t["nome"] in i.tags for i in self.registros["nota"])
                linha.append(Gtk.Label(label=f"{usos} nota(s)", hexpand=True, xalign=0,
                                       css_classes=["dica"]))
                apagar = Gtk.Button(icon_name="user-trash-symbolic", css_classes=["flat"],
                                    tooltip_text="Apagar tag (sai de todas as notas)")
                apagar.connect("clicked", lambda *_, n=t["nome"], u=usos:
                               self.confirmar_apagar_tag(n, u, recarregar))
                linha.append(apagar)
                lista.append(linha)

        nome = Gtk.Entry(placeholder_text="Nome da nova tag", hexpand=True)
        amostras = Gtk.Box(spacing=8)
        escolhida = ["roxo"]
        grupo = None
        for cor in CORES_TAG:
            b = Gtk.ToggleButton(css_classes=["amostra", f"cor-{cor}"], tooltip_text=cor,
                                 active=cor == "roxo")
            if grupo:
                b.set_group(grupo)
            grupo = grupo or b
            b.connect("toggled", lambda bt, c=cor: bt.get_active() and escolhida.__setitem__(0, c))
            amostras.append(b)

        def adicionar(*_):
            n = nome.get_text().strip().lstrip("#").replace(",", " ")
            if n and not any(t["nome"] == n for t in self.tags):
                self.tags.append({"nome": n, "cor": escolhida[0]})
                self.gravar_tags()
                nome.set_text("")
                recarregar()
                self.atualizar_filtro_tags()
        nome.connect("activate", adicionar)
        bt_add = Gtk.Button(label="Adicionar", css_classes=["suggested-action"])
        bt_add.connect("clicked", adicionar)
        linha_nova = Gtk.Box(spacing=8)
        linha_nova.append(nome)
        linha_nova.append(bt_add)

        caixa = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12,
                        margin_start=18, margin_end=18, margin_top=12, margin_bottom=18)
        caixa.append(Gtk.Label(label="NOVA TAG", xalign=0, css_classes=["secao"]))
        caixa.append(linha_nova)
        caixa.append(amostras)
        caixa.append(Gtk.Label(label="SUAS TAGS", xalign=0, margin_top=8, css_classes=["secao"]))
        caixa.append(Gtk.ScrolledWindow(child=lista, vexpand=True))
        recarregar()

        tv = Adw.ToolbarView(content=caixa)
        tv.add_top_bar(Adw.HeaderBar())
        dialogo.set_child(tv)
        dialogo.connect("closed", lambda *_: (self.atualizar_tags_registro(), self.recarregar_lista()))
        self.apresentar(dialogo)

    def confirmar_apagar_tag(self, nome, usos, depois):
        d = Adw.AlertDialog(heading=f"Apagar a tag #{nome}?",
                            body=f"Ela sai de {usos} nota(s). As notas continuam existindo."
                            if usos else "Nenhuma nota usa esta tag.")
        d.add_response("cancelar", "Cancelar")
        d.add_response("apagar", "Apagar tag")
        d.set_response_appearance("apagar", Adw.ResponseAppearance.DESTRUCTIVE)
        d.connect("response", lambda _d, r: r == "apagar" and (self.apagar_tag(nome), depois()))
        self.apresentar(d)

    def apagar_tag(self, nome):
        self.salvar_agora()
        self.tags = [t for t in self.tags if t["nome"] != nome]
        self.gravar_tags()
        for r in self.registros["nota"]:
            if nome in r.tags:
                r.tags.remove(nome)
                self.pendentes.add(r)
        self.salvar_agora(modificar=False)
        if self.filtro_tag == nome:
            self.filtro_tag = None
        self.atualizar_filtro_tags()

    # ------------------------------------------------------------------
    # dados
    # ------------------------------------------------------------------
    def carregar_tudo(self):
        try:
            self.repo.preparar()
        except OSError as e:
            self.avisar(f"Problema ao preparar a pasta {self.repo.pasta}: {e.strerror or e}")
        for tipo in TIPOS:
            self.registros[tipo] = self.repo.carregar(tipo)
        self.atualizar_filtro_tags()

    def adicionar_registro(self, r: Registro):
        lista = self.registros[r.tipo]
        if r not in lista and not any(x.rel == r.rel for x in lista):
            lista.append(r)

    def sincronizar_disco(self):
        """Ao voltar para a janela: pega registros criados, apagados ou editados fora do app."""
        if self.repo is None:
            return
        if self.pendentes:
            self.salvar_agora()
        mudou = self.repo.armazem.atualizar()
        for tipo in TIPOS:
            no_disco = set(self.repo.arquivos(tipo))
            conhecidos = {r.rel: r for r in self.registros[tipo]}
            for p in no_disco - conhecidos.keys():
                if self.atual is not None and self.atual.rel == p:
                    if self.atual in self.pendentes:
                        continue    # a próxima gravação vai acusar o conflito
                    r = self.atual
                    with contextlib.suppress(OSError, UnicodeDecodeError, CofreError):
                        r.carregar()
                    self.mostrar(r, forcar=True)
                elif not (r := self.repo.ler(p, tipo)):
                    continue
                self.adicionar_registro(r)
                mudou = True
            for c, r in conhecidos.items():
                if r in self.pendentes:
                    continue
                if c not in no_disco:
                    if r is not self.atual:
                        self.registros[tipo].remove(r)
                        mudou = True
                elif r.alterado_fora():
                    with contextlib.suppress(OSError, UnicodeDecodeError, CofreError):
                        r.carregar()
                        mudou = True
                        if r is self.atual:
                            self.mostrar(r, forcar=True)
        if mudou:
            self.recarregar_lista()
            self.marcar_calendario()

    def visiveis(self):
        if self.buscando():
            tipos = [None, {"nota"}, {"diario"}, {"exame"}][self.dd_tipo.get_selected()]
            hoje = date.today()
            desde = [None, hoje - timedelta(days=7), hoje - timedelta(days=30),
                     date(hoje.year, 1, 1)][self.dd_periodo.get_selected()]
            todos = [r for t in TIPOS for r in self.registros[t]]
            todos.sort(key=lambda r: (r.data(), r.modificada), reverse=True)
            return list(buscar(todos, self.busca.get_text(), tipos, desde))
        if self.modo == "pensamento":
            return self.pensamentos_visiveis()
        if self.modo != "nota":
            return sorted(self.registros[self.modo], key=lambda r: r.nome, reverse=True)
        notas = sorted(self.registros["nota"], key=lambda r: r.modificada, reverse=True)
        notas.sort(key=lambda r: (not r.fixada, r.feita))
        return [r for r in notas
                if not (self.filtro == "pendentes" and r.feita)
                and not (self.filtro == "feitas" and not r.feita)
                and not (self.filtro_tag and self.filtro_tag not in r.tags)]

    def recarregar_lista(self):
        self.carregando = True
        self.lista.remove_all()
        alvo = None
        pens = self.modo == "pensamento"
        visiveis = self.visiveis()
        for r in visiveis:
            row = self.criar_linha_pensamento(r) if pens else self.criar_linha(r)
            self.lista.append(row)
            if r is (self.pens_atual if pens else self.atual):
                alvo = row
        if pens:
            total = len(self.biblioteca.todos()) if self.biblioteca else 0
            self.rotulo_lista.set_label(f"PENSAMENTOS · {len(visiveis)}"
                                        + (f" DE {total}" if len(visiveis) != total else ""))
        if alvo:
            self.lista.select_row(alvo)
        else:
            self.lista.unselect_all()
        self.carregando = False
        if alvo is None and self.atual is None and self.modo == "nota" and not self.buscando() \
                and self.repo is not None:
            primeira = self.lista.get_row_at_index(0)
            if primeira:
                self.lista.select_row(primeira)
            else:
                self.mostrar(None)

    def cabecalho_lista(self, row, antes):
        """No diário e no exame, separa o histórico por mês."""
        if (self.buscando() or self.modo in ("nota", "pensamento") or not hasattr(row, "registro")
                or (antes is not None and not hasattr(antes, "registro"))):
            row.set_header(None)
            return
        d = row.registro.data()
        if antes is not None:
            a = antes.registro.data()
            if (a.year, a.month) == (d.year, d.month):
                row.set_header(None)
                return
        row.set_header(Gtk.Label(label=f"{MESES[d.month - 1]} de {d.year}".upper(), xalign=0,
                                 css_classes=["secao", "cab-mes"]))

    def criar_linha(self, r: Registro):
        _, nome_tipo, icone_tipo, cor_tipo = TIPOS[r.tipo]
        buscando = self.buscando()
        if r.tipo == "nota" and not buscando:
            icone = "󰄲" if r.feita else ("󰐃" if r.fixada else icone_tipo)
            cor = "verde" if r.feita else ("roxo" if r.fixada else cor_tipo)
        else:
            icone, cor = icone_tipo, cor_tipo
        lbl_icone = Gtk.Label(label=icone, valign=Gtk.Align.START, margin_top=2,
                              css_classes=[f"icone-{cor}"],
                              tooltip_text="Fixada" if r.fixada and not buscando else nome_tipo)
        titulo = Gtk.Label(label=r.titulo_exibido(), xalign=0, ellipsize=Pango.EllipsizeMode.END,
                           wrap=True, wrap_mode=Pango.WrapMode.WORD_CHAR, lines=2,
                           width_chars=1, css_classes=["lista-titulo"])
        if r.tipo == "nota" and r.feita:
            titulo.add_css_class("feita-titulo")
        textos = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3, hexpand=True)
        textos.append(titulo)

        if buscando:
            meta = f"{nome_tipo} · {r.data():%d/%m/%Y}"
        elif r.tipo == "nota":
            meta = f"󰃭 Criada em {mostrar_data(r.criada, False)}"
        else:
            meta = f"󰃭 {r.data():%d/%m/%Y}"
            if r.tipo == "diario" and r.humor:
                meta += f" · {r.humor}"
        textos.append(Gtk.Label(label=meta, xalign=0, css_classes=["lista-data"]))

        marcas = ""
        if r.tags:
            marcas = " ".join(f"<span foreground='{CORES_TAG.get(self.cor_da_tag(n), '#9a96b8')}'>"
                              f"#{GLib.markup_escape_text(n)}</span>" for n in r.tags)
        elif r.tipo == "exame" and r.virtudes:
            marcas = "  ".join(f"<span foreground='{CORES_TAG[cor]}'>{ic} {n}</span>"
                               for n, ic, cor, _ in VIRTUDES if n in r.virtudes)
        if marcas:
            textos.append(Gtk.Label(label=marcas, use_markup=True, xalign=0, wrap=True,
                                    css_classes=["lista-tags"]))
        if buscando or r.tipo == "diario":
            antes, achado, depois = trecho(r.texto, self.busca.get_text() if buscando else "", 90)
            if antes or achado:
                esc = GLib.markup_escape_text
                lbl = Gtk.Label(use_markup=True, xalign=0, wrap=True, lines=2,
                                ellipsize=Pango.EllipsizeMode.END, width_chars=1,
                                css_classes=["lista-trecho"],
                                label=f"{esc(antes)}<b><span foreground='{C['h3']}'>{esc(achado)}"
                                      f"</span></b>{esc(depois)}")
                textos.append(lbl)

        box = Gtk.Box(spacing=10, margin_top=6, margin_bottom=6)
        box.append(lbl_icone)
        box.append(textos)
        row = Gtk.ListBoxRow(child=box)
        row.registro = r
        menu = Gtk.GestureClick(button=Gdk.BUTTON_SECONDARY)
        menu.connect("pressed", lambda _g, _n, x, y, rw=row: self.menu_registro(rw, x, y))
        row.add_controller(menu)
        return row

    def menu_registro(self, row, x, y):
        r = row.registro
        ref = [None]
        caixa = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, margin_top=4, margin_bottom=4)
        caixa.append(item_menu("󰏫  Abrir", lambda: self.lista.select_row(row), ref))
        if r.tipo == "nota":
            caixa.append(item_menu("󰐃  Desafixar" if r.fixada else "󰐃  Fixar no topo",
                                   lambda: self.definir_fixada(r, not r.fixada), ref))
            caixa.append(item_menu("󰄱  Marcar como pendente" if r.feita else "󰄲  Marcar como feita",
                                   lambda: self.definir_feita(r, not r.feita), ref))
        caixa.append(item_menu("󰈙  Abrir em um editor externo", lambda: self.abrir_externo(r), ref))
        caixa.append(Gtk.Separator(margin_top=4, margin_bottom=4))
