def iter_em(buf, linha, coluna):
    r = buf.get_iter_at_line_offset(linha, coluna)
    return r[1] if isinstance(r, tuple) else r


def popover_em(widget, x, y, filho):
    """Abre um popover (menu) no ponto clicado e o destrói ao fechar."""
    pop = Gtk.Popover(child=filho, has_arrow=False, halign=Gtk.Align.START)
    pop.set_parent(widget)
    r = Gdk.Rectangle()
    r.x, r.y, r.width, r.height = int(x), int(y), 1, 1
    pop.set_pointing_to(r)
    pop.connect("closed", lambda p: GLib.idle_add(p.unparent))
    pop.popup()
    return pop


def item_menu(texto, acao, pop_ref, perigo=False):
    bt = Gtk.Button(child=Gtk.Label(label=texto, xalign=0), css_classes=["menu-item"])
    if perigo:
        bt.add_css_class("perigo")

    def clicou(*_):
        pop_ref[0].popdown()
        acao()
    bt.connect("clicked", clicou)
    return bt


class Editor(Gtk.TextView):
    """TextView que formata o Markdown enquanto você escreve."""

    RE_NEGRITO = re.compile(r"\*\*(.+?)\*\*")
    RE_ITALICO = re.compile(r"(?<![*\w])\*(?!\s)([^*]+?)\*(?![*\w])")
    RE_CODIGO = re.compile(r"`([^`]+)`")
    RE_TAREFA = re.compile(r"^(\s*)(- )(\[([ xX])\])( |$)")

    def __init__(self, bottom_margin=40, vexpand=True):
        super().__init__(wrap_mode=Gtk.WrapMode.WORD_CHAR, vexpand=vexpand,
                         pixels_below_lines=7, pixels_inside_wrap=3, top_margin=4,
                         bottom_margin=bottom_margin, css_classes=["editor"])
        buf = self.get_buffer()
        mono = "iA Writer Mono S"
        t = {}
        t["h1"] = buf.create_tag("h1", scale=1.6, weight=700, foreground=C["h1"], family=mono, pixels_above_lines=10)
        t["h2"] = buf.create_tag("h2", scale=1.3, weight=700, foreground=C["h2"], family=mono, pixels_above_lines=8)
        t["h3"] = buf.create_tag("h3", scale=1.12, weight=700, foreground=C["h3"], family=mono, pixels_above_lines=6)
        t["citacao"] = buf.create_tag("citacao", style=Pango.Style.ITALIC, foreground="#a9a1cf",
                                      left_margin=18, paragraph_background="#0a1238")
        t["negrito"] = buf.create_tag("negrito", weight=800, foreground=C["texto_forte"])
        t["italico"] = buf.create_tag("italico", style=Pango.Style.ITALIC, foreground="#9cc7d8")
        t["codigo"] = buf.create_tag("codigo", family=mono, background="#150f3a", foreground="#f08fc0")
        t["marcador"] = buf.create_tag("marcador", foreground=C["acento"], weight=900)
        t["caixa"] = buf.create_tag("caixa", foreground=C["acento"], weight=900, family=mono)
        t["caixa-feita"] = buf.create_tag("caixa-feita", foreground=C["ok"], weight=900, family=mono)
        t["riscado"] = buf.create_tag("riscado", strikethrough=True, foreground=C["fraco"])
        t["regua"] = buf.create_tag("regua", foreground=C["borda"], weight=900)
        t["simbolo"] = buf.create_tag("simbolo", foreground=C["fraco"])
        t["oculto"] = buf.create_tag("oculto", invisible=True)
        self.tags = t

        buf.connect("changed", lambda *_: self.estilizar())
        buf.connect("notify::cursor-position", lambda *_: self.estilizar())
        foco = Gtk.EventControllerFocus()
        foco.connect("enter", lambda *_: self.estilizar())
        foco.connect("leave", lambda *_: self.estilizar())
        self.add_controller(foco)

        clique = Gtk.GestureClick(propagation_phase=Gtk.PropagationPhase.CAPTURE)
        clique.connect("pressed", self.on_clique)
        self.add_controller(clique)

    def conteudo(self):
        buf = self.get_buffer()
        return buf.get_text(buf.get_start_iter(), buf.get_end_iter(), True)

    def definir(self, texto):
        buf = self.get_buffer()
        buf.begin_irreversible_action()
        buf.set_text(texto)
        buf.end_irreversible_action()
        buf.place_cursor(buf.get_start_iter())
        self.estilizar()

    def estilizar(self):
        buf = self.get_buffer()
        ini, fim = buf.get_bounds()
        buf.remove_all_tags(ini, fim)
        linha_cursor = buf.get_iter_at_mark(buf.get_insert()).get_line() if self.has_focus() else -1

        for n, linha in enumerate(self.conteudo().split("\n")):
            ativa = n == linha_cursor

            def tag(nome, a, b, n=n):
                if b > a:
                    buf.apply_tag(self.tags[nome], iter_em(buf, n, a), iter_em(buf, n, b))

            def simbolo(a, b):
                tag("simbolo" if ativa else "oculto", a, b)

            if m := re.match(r"^(#{1,3}) ", linha):
                tag(f"h{len(m.group(1))}", 0, len(linha))
                simbolo(0, m.end())
            elif re.fullmatch(r"\s*(-{3,}|\*{3,})\s*", linha):
                tag("regua" if not ativa else "simbolo", 0, len(linha))
            elif m := re.match(r"^> ?", linha):
                tag("citacao", 0, len(linha))
                simbolo(0, m.end())
            elif m := self.RE_TAREFA.match(linha):
                simbolo(m.start(2), m.end(2))
                feita = m.group(4) in "xX"
                tag("caixa-feita" if feita else "caixa", m.start(3), m.end(3))
                if feita:
                    tag("riscado", m.end(3), len(linha))
            elif m := re.match(r"^(\s*)([-*+]|\d+\.) ", linha):
                tag("marcador", m.start(2), m.end(2))

            for regex, nome, tam in ((self.RE_NEGRITO, "negrito", 2),
                                     (self.RE_ITALICO, "italico", 1),
                                     (self.RE_CODIGO, "codigo", 1)):
                for m in regex.finditer(linha):
                    tag(nome, m.start(1), m.end(1))
                    simbolo(m.start(), m.start() + tam)
                    simbolo(m.end() - tam, m.end())

    def on_clique(self, gesto, _n, x, y):
        """Clicar no [ ] / [x] marca ou desmarca a tarefa."""
        bx, by = self.window_to_buffer_coords(Gtk.TextWindowType.WIDGET, int(x), int(y))
        r = self.get_iter_at_location(bx, by)
        it = r[1] if isinstance(r, tuple) else r
        if it is None:
            return
        n, col = it.get_line(), it.get_line_offset()
        linha = self.conteudo().split("\n")[n]
        m = self.RE_TAREFA.match(linha)
        if not m or not (m.start(3) <= col <= m.end(3)):
            return
        buf = self.get_buffer()
        novo = " " if m.group(4) in "xX" else "x"
        buf.begin_user_action()
        buf.delete(iter_em(buf, n, m.start(4)), iter_em(buf, n, m.end(4)))
        buf.insert(iter_em(buf, n, m.start(4)), novo)
        buf.end_user_action()
        gesto.set_state(Gtk.EventSequenceState.CLAIMED)


def com_dica(editor: Editor, texto):
    """Põe um texto de exemplo sobre o editor enquanto ele está vazio."""
    ov = Gtk.Overlay(child=editor)
    dica = Gtk.Label(label=texto, xalign=0, valign=Gtk.Align.START, halign=Gtk.Align.START,
                     can_target=False, margin_top=editor.get_top_margin(),
                     css_classes=["editor", "editor-dica"])
    ov.add_overlay(dica)
    buf = editor.get_buffer()
    atualizar = lambda *_: dica.set_visible(buf.get_char_count() == 0)  # noqa: E731
    buf.connect("changed", atualizar)
    atualizar()
    ov.dica = dica
    return ov


class CampoTitulo(Gtk.Overlay):
    """Título que quebra linha (até 3 linhas visíveis; depois rola)."""

    MAX_LINHAS = 3

    def __init__(self, placeholder, ao_enter):
        super().__init__()
        self.view = Gtk.TextView(wrap_mode=Gtk.WrapMode.WORD_CHAR, accepts_tab=False,
                                 css_classes=["titulo-ideia"])
        self.buf = self.view.get_buffer()
        self.rolagem = Gtk.ScrolledWindow(child=self.view,
                                          hscrollbar_policy=Gtk.PolicyType.NEVER,
                                          vscrollbar_policy=Gtk.PolicyType.EXTERNAL)
        self._largura = 0
        self.rolagem.get_hadjustment().connect("changed", self.on_largura)
        self.set_child(self.rolagem)
        self.dica = Gtk.Label(label=placeholder, xalign=0, valign=Gtk.Align.START,
                              can_target=False, css_classes=["titulo-ideia", "titulo-dica"])
        self.add_overlay(self.dica)

        teclas = Gtk.EventControllerKey()

        def tecla(_c, kv, _code, _mods):
            if kv in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
                ao_enter()
                return True
            return False
        teclas.connect("key-pressed", tecla)
        self.view.add_controller(teclas)
        self.buf.connect("changed", self.on_changed)

    def on_largura(self, adj):
        # O TextView não sabe calcular a própria altura quando a largura muda,
        # então a altura (1 a 3 linhas) é calculada aqui com o Pango.
        largura = int(adj.get_page_size())
        if largura != self._largura:
            self._largura = largura
            GLib.idle_add(self.ajustar_altura)

    def ajustar_altura(self):
        if self._largura <= 0:
            return False
        linha = self.view.create_pango_layout("Ág").get_pixel_size()[1]
        layout = self.view.create_pango_layout(self.get_text() or "Ág")
        layout.set_width(self._largura * Pango.SCALE)
        layout.set_wrap(Pango.WrapMode.WORD_CHAR)
        linhas = min(max(layout.get_line_count(), 1), self.MAX_LINHAS)
        altura = linhas * linha + 2
        if self.rolagem.get_size_request()[1] != altura:
            self.rolagem.set_size_request(-1, altura)
        return False

    def on_changed(self, _buf):
        texto = self.get_text()
        if "\n" in texto:  # colou texto com várias linhas: vira uma linha só
            GLib.idle_add(self.set_text, " ".join(texto.split()))
        self.dica.set_visible(texto == "")
        self.ajustar_altura()

    def definir_dica(self, texto):
        self.dica.set_label(texto)

    def get_text(self):
        return self.buf.get_text(self.buf.get_start_iter(), self.buf.get_end_iter(), False)

    def set_text(self, texto):
        self.buf.set_text(texto)
        return False

    def connect_changed(self, func):
        self.buf.connect("changed", func)

    def grab_focus(self):
        return self.view.grab_focus()


class SecaoExame(Gtk.Box):
    """Uma pergunta do exame com o seu próprio campo de texto."""

    def __init__(self, titulo, pergunta="", contexto="", extra=None, ao_mudar=None):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        self.titulo_md = titulo
        self.append(Gtk.Label(label=titulo, xalign=0, wrap=True, css_classes=["secao-titulo"]))
        if pergunta:
            self.append(Gtk.Label(label=pergunta, xalign=0, wrap=True,
                                  css_classes=["secao-pergunta", "prosa"]))
        if contexto:
            self.append(Gtk.Label(label=contexto, xalign=0, wrap=True, css_classes=["secao-contexto"]))
        if extra:
            self.append(extra)
        self.editor = Editor(bottom_margin=8, vexpand=False)
        self.editor.add_css_class("prosa")
        campo = com_dica(self.editor, "Escreva aqui, se quiser…")
        campo.dica.add_css_class("prosa")
        campo.add_css_class("campo")
        self.append(campo)
        if ao_mudar:
            self.editor.get_buffer().connect("changed", lambda *_: ao_mudar())


class Janela(Adw.ApplicationWindow):
    """Com repo: abre direto (pasta comum ou cofre já desbloqueado). Sem repo: mostra o
    cadeado do cofre que está em `pasta`."""

    def __init__(self, app, repo: Repositorio | None, pasta=None):
        super().__init__(application=app, title="MyNotes")
        self.set_default_size(1100, 720)
        self.pasta = Path(pasta) if pasta else repo.pasta
        self.repo: Repositorio | None = None
        self.biblioteca: Biblioteca | None = None
        self.publicos, self.erro_publicos = carregar_biblioteca_publica(ARQ_BIBLIOTECA)
        self.ajustes = ler_ajustes(self.pasta)
        self.ultima_atividade = time.monotonic()
        self.dialogos: list = []          # diálogos abertos (fechados ao bloquear)
        self.toasts_ativos: list = []
        self.ocupado = False              # operação longa em andamento (derivação de chave…)
        self.falhas_senha = 0
        self.registros: dict[str, list[Registro]] = {t: [] for t in TIPOS}
        self.modo = "nota"
        self.atual: Registro | None = None
        self.ultimo: dict[str, Registro | None] = {}
        self.datas = {"diario": date.today(), "exame": date.today()}
        self.pendentes: set[Registro] = set()   # alterados e ainda não gravados
        self.conflitos_avisados: set[Registro] = set()
        self.ultimo_erro = ""
        self.carregando = False
        self.trocando_modo = False
        self.ajustando_cal = False
        self.fechar_mesmo_assim = False
        self.timer_salvar = 0
        self.filtro = "todas"
        self.filtro_tag: str | None = None
        self.carregando_filtros = False
        self.pens_atual: dict | None = None      # pensamento aberto na biblioteca
        self.pens_exame: dict | None = None      # pensamento mostrado no exame
        self.foco = False
        self.estreita = False      # janela estreita: botões do topo só com ícone
        self.estado_atual = ""
        self.tags = []

        self.toasts = Adw.ToastOverlay()
        self.split = Adw.OverlaySplitView(sidebar=self.montar_lateral(),
                                          content=self.montar_conteudo(),
                                          min_sidebar_width=320, max_sidebar_width=380)
        self.toasts.set_child(self.split)
        self.raiz = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE,
                              vhomogeneous=False, hhomogeneous=False)
        self.raiz.add_named(self.toasts, "app")
        self.raiz.add_named(self.montar_cadeado(), "cadeado")
        self.set_content(self.raiz)
        estreita = Adw.Breakpoint.new(Adw.BreakpointCondition.parse("max-width: 760sp"))
        estreita.add_setter(self.split, "collapsed", True)
        estreita.add_setter(self.split, "show-sidebar", False)
        estreita.connect("apply", lambda *_: self.definir_estreita(True))
        estreita.connect("unapply", lambda *_: self.definir_estreita(False))
        self.add_breakpoint(estreita)
        self.montar_acoes()
        self.split.bind_property("show-sidebar", self.bt_lateral, "active",
                                 GObject.BindingFlags.BIDIRECTIONAL | GObject.BindingFlags.SYNC_CREATE)
        self.split.bind_property("collapsed", self.bt_lateral, "visible",
                                 GObject.BindingFlags.SYNC_CREATE)

        self.connect("close-request", self.on_fechar)
        self.connect("notify::is-active", lambda *_: self.is_active() and self.sincronizar_disco())
        # qualquer tecla, clique ou movimento conta como atividade (para o bloqueio automático)
        atividade = Gtk.EventControllerLegacy(propagation_phase=Gtk.PropagationPhase.CAPTURE)
        atividade.connect("event", self.on_atividade)
        self.add_controller(atividade)
        fonte = GLib.timeout_add_seconds(15, self.verificar_inatividade)
        self.connect("destroy", lambda *_: GLib.source_remove(fonte))

        if repo is not None:
            self.ativar(repo)
        else:
            self.mostrar_cadeado()

    # ------------------------------------------------------------------
    # abrir (ativar) e bloquear
    # ------------------------------------------------------------------
    def ativar(self, repo: Repositorio):
        """Passa a mostrar os dados de `repo` (pasta comum ou cofre desbloqueado)."""
        self.repo = repo
        self.pasta = repo.pasta
        self.ajustes = ler_ajustes(self.pasta)
        self.tags = repo.carregar_tags()
        self.biblioteca = Biblioteca(self.publicos, repo.armazem)
        self.ultima_atividade = time.monotonic()
        self.carregar_tudo()
        self.atualizar_menu()
        self.set_focus(None)
        self.raiz.set_visible_child_name("app")
        self.atual = None
        if self.modo == "nota":
            self.aplicar_modo()
            self.recarregar_lista()
        elif self.modo == "pensamento":
            self.aplicar_modo()
            self.abrir_pensamento_do_dia()
        else:
            self.abrir_dia(date.today())
        erros = [*repo.erros, *getattr(repo.armazem, "erros", [])]
        if erros:
            self.avisar(f"{len(erros)} arquivo(s) não puderam ser lidos e foram ignorados: "
                        + ", ".join(erros[:3]))
        for erro in (self.erro_publicos, self.biblioteca.erro):
            if erro:
                self.avisar(erro)

    def motivo_para_nao_bloquear(self):
        """Bloquear agora perderia algo? (texto não salvo ou formulário preenchido)"""
        self.salvar_agora()
        if self.pendentes:
            return ("Há alterações que não puderam ser salvas (veja o aviso “Falha ao salvar” ou "
                    "“Conflito”). O cofre continua aberto para não perder o texto.")
        for d in self.dialogos:
            if getattr(d, "rascunho", None) and d.rascunho():
                return "Há um formulário com texto preenchido. Salve ou cancele antes de bloquear."
        if self.ocupado:
            return "Espere a operação em andamento terminar."
        return None

    def bloquear(self, automatico=False):
        """Esconde e esquece tudo o que foi decifrado. Nunca descarta texto não salvo:
        se houver algo pendente, não bloqueia e explica o motivo."""
        if self.repo is None or not self.repo.cifrado:
            return False
        motivo = self.motivo_para_nao_bloquear()
        if motivo:
            if automatico:
                self.ultima_atividade = time.monotonic()     # tenta de novo mais tarde
                self.avisar(f"Bloqueio automático adiado. {motivo}")
            else:
                self.erro_dialogo("O cofre não foi bloqueado", motivo)
            return False
        self.desativar()
        self.mostrar_cadeado()
        return True

    def desativar(self):
        """Limpa as telas, a lista, a busca e a memória do que foi decifrado."""
        for d in list(self.dialogos):
            with contextlib.suppress(Exception):
                d.force_close() if isinstance(d, Adw.Dialog) else d.close()
        self.dialogos.clear()
        for t in list(self.toasts_ativos):
            t.dismiss()
        self.toasts_ativos.clear()
        if self.foco:
            self.alternar_foco()
        self.carregando = True
        self.atual = None
        self.pendentes.clear()
        self.conflitos_avisados.clear()
        self.ultimo = {}
        self.registros = {t: [] for t in TIPOS}
        self.tags = []
        self.pens_atual = self.pens_exame = None
        self.busca.set_text("")
        self.lista.remove_all()
        self.ent_titulo.set_text("")
        for ed in (self.editor, *(s.editor for s in self.secoes.values()),
                   *(s.editor for s in self.secoes_extras)):
            ed.definir("")
            buf = ed.get_buffer()
            buf.set_enable_undo(False)       # apaga também o histórico de desfazer
            buf.set_enable_undo(True)
        for s in self.secoes_extras:
            self.caixa_secoes.remove(s)
        self.secoes_extras = []
        self.caixa_tags.remove_all()
        self.caixa_filtro_tags.remove_all()
        self.calendario.clear_marks()
        for lbl in (self.lbl_citacao, self.lbl_autor, self.lbl_pens_meta, self.pp_texto,
                    self.pp_autor, self.pp_obra, self.pp_rotulo):
            lbl.set_label("")
        limpar(self.pp_chips)
        limpar(self.pp_detalhes)
        self.carregando = False
        self.pilha.set_visible_child_name("vazio")
        if self.repo is not None:
            self.repo.armazem.fechar()
        self.repo = None
        self.biblioteca = None
        gc.collect()

    def on_atividade(self, _ctrl, _evento):
        self.ultima_atividade = time.monotonic()
        return False

    def verificar_inatividade(self):
        minutos = int(self.ajustes.get("bloqueio_min") or 0)
        if (minutos > 0 and self.repo is not None and self.repo.cifrado and not self.ocupado
                and time.monotonic() - self.ultima_atividade >= minutos * 60):
            self.bloquear(automatico=True)
        return True

    # ------------------------------------------------------------------
    # montagem da interface
    # ------------------------------------------------------------------
    def montar_lateral(self):
        header = Adw.HeaderBar()
        header.set_title_widget(Adw.WindowTitle(title="󰌵  MyNotes"))
        self.bt_menu = Gtk.MenuButton(icon_name="open-menu-symbolic",
                                      tooltip_text="Cofre, exportação, backup e privacidade",
                                      css_classes=["flat"])
        header.pack_end(self.bt_menu)
        self.bt_bloquear = Gtk.Button(icon_name="system-lock-screen-symbolic", css_classes=["flat"],
                                      tooltip_text="Bloquear o cofre agora (Ctrl+L)", visible=False)
        self.bt_bloquear.connect("clicked", lambda *_: self.bloquear())
        header.pack_end(self.bt_bloquear)

        # as quatro áreas (ícone em cima, nome embaixo)
        self.modos = Adw.ToggleGroup(css_classes=["modos"], homogeneous=True)
        for tipo, icone, rotulo, dica in (
