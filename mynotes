    def dialogo_trocar_senha(self, exigir_atual=True, aviso=None):
        if self.repo is None or not self.repo.cifrado:
            return None
        d = Adw.Dialog(title="Trocar a senha", content_width=600, content_height=640)
        atual = Gtk.PasswordEntry(show_peek_icon=True, placeholder_text="Senha atual", hexpand=True)
        bt = Gtk.Button(label="Trocar a senha", css_classes=["suggested-action"], sensitive=False)
        erro = Gtk.Label(xalign=0, wrap=True, css_classes=["erro-texto"], visible=False)
        spinner = Adw.Spinner(visible=False, halign=Gtk.Align.START)

        def mudou():
            bt.set_sensitive(bool(obter()[0]) and (not exigir_atual or bool(atual.get_text())))
        campos, obter = self.campos_senha(lambda: mudou())
        atual.connect("changed", lambda *_: mudou())
        caixa = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10,
                        margin_start=24, margin_end=24, margin_top=8, margin_bottom=18)
        if aviso:
            caixa.append(Gtk.Label(label=aviso, xalign=0, wrap=True, css_classes=["prosa-pequena"]))
        caixa.append(Gtk.Label(
            label="Os registros não precisam ser cifrados de novo: só a chave do cofre é protegida "
                  "outra vez com a nova senha. Backups feitos antes continuam abrindo com a senha "
                  "que o cofre tinha na época.", xalign=0, wrap=True, css_classes=["dica"]))
        if exigir_atual:
            caixa.append(Gtk.Label(label="SENHA ATUAL", xalign=0, css_classes=["secao"]))
            caixa.append(atual)
        caixa.append(Gtk.Label(label="NOVA SENHA", xalign=0, margin_top=8, css_classes=["secao"]))
        caixa.append(campos)
        caixa.append(spinner)
        caixa.append(erro)

        def trocar(*_):
            nova = obter()[0]
            if not nova or self.repo is None:
                return
            senha_atual = atual.get_text()
            chave = self.repo.armazem._chave
            pasta = self.pasta
            bt.set_sensitive(False)
            spinner.set_visible(True)
            erro.set_visible(False)
            d.set_can_close(False)

            def trabalho():
                if exigir_atual and abrir_cofre(pasta, senha_atual) != chave:
                    raise SenhaIncorreta()
                trocar_senha(pasta, chave, nova)

            def fim(_r, e):
                spinner.set_visible(False)
                d.set_can_close(True)
                if e is not None:
                    erro.set_label("A senha atual está incorreta." if isinstance(e, SenhaIncorreta)
                                   else f"Não foi possível trocar a senha: {e}. A senha antiga "
                                        "continua valendo.")
                    erro.set_visible(True)
                    mudou()
                    return
                d.close()
                self.avisar("Senha trocada. O cofre foi aberto de novo com a nova senha para conferir.")
            self.em_segundo_plano(trabalho, fim)
        bt.connect("clicked", trocar)
        d.trocar, d.atual, d.campos = trocar, atual, campos
        rodape = Gtk.Box(spacing=8, halign=Gtk.Align.END, margin_top=10, margin_bottom=12, margin_end=22)
        bt_cancelar = Gtk.Button(label="Agora não" if not exigir_atual else "Cancelar")
        bt_cancelar.connect("clicked", lambda *_: d.close())
        rodape.append(bt_cancelar)
        rodape.append(bt)
        tv = Adw.ToolbarView(content=Gtk.ScrolledWindow(child=caixa, hscrollbar_policy=Gtk.PolicyType.NEVER))
        tv.add_top_bar(Adw.HeaderBar())
        tv.add_bottom_bar(rodape)
        d.set_child(tv)
        self.apresentar(d)
        return d

