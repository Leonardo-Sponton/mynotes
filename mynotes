def agora():
    return datetime.now().strftime(FORMATO)


def ler_data(texto):
    try:
        return datetime.fromisoformat(texto.strip())
    except (ValueError, AttributeError):
        return None


def mostrar_data(texto, com_hora=True):
    d = ler_data(texto) if texto else None
    if d is None:
        return "—"
    if com_hora and (d.hour or d.minute):
        return d.strftime("%d/%m/%Y às %H:%M")
    return d.strftime("%d/%m/%Y")


def titulo_do_dia(d: date):
    t = f"{DIAS[d.weekday()]}, {d.day} de {MESES[d.month - 1]}"
    return t if d.year == date.today().year else f"{t} de {d.year}"


@lru_cache(maxsize=4096)
def _dobrar_letra(c):
    base = "".join(x for x in unicodedata.normalize("NFD", c) if not unicodedata.combining(x))
    return (base or c).lower()[:1] or c


def dobrar(texto):
    """Minúsculas e sem acentos, mantendo uma letra para cada letra do original
    (assim a posição de um trecho encontrado vale para o texto original)."""
    return "".join(_dobrar_letra(c) for c in texto)


def criar_pasta(p: Path):
    """mkdir -p, mas com permissão 700 em cada pasta criada."""
    p = Path(p)
    if p.is_dir():
        return
    criar_pasta(p.parent)
    with contextlib.suppress(FileExistsError):
        p.mkdir(mode=0o700)


def escrever_atomico(caminho: Path, dados) -> int:
    """Grava num arquivo temporário (600), força a gravação no disco e só então troca pelo
    original. Depois relê o arquivo para confirmar que o conteúdo foi mesmo gravado.
    Devolve o mtime_ns do arquivo gravado."""
    if isinstance(dados, str):
        dados = dados.encode("utf-8")
    caminho = Path(caminho)
    criar_pasta(caminho.parent)
    fd, tmp = tempfile.mkstemp(dir=caminho.parent, prefix=f".{caminho.name}.", suffix=".tmp")
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(dados)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, caminho)
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(tmp)
        raise
    with contextlib.suppress(OSError):
        dfd = os.open(caminho.parent, os.O_RDONLY)
        try:
            os.fsync(dfd)
        finally:
            os.close(dfd)
    if caminho.read_bytes() != dados:
        raise OSError(errno.EIO, "o conteúdo gravado não confere com o do app", str(caminho))
    return caminho.stat().st_mtime_ns


def proteger(caminho: Path, modo: int):
    """Deixa só o dono ler/gravar (700 nas pastas, 600 nos arquivos)."""
    with contextlib.suppress(OSError):
        if caminho.stat().st_mode & 0o777 != modo:
            os.chmod(caminho, modo)


