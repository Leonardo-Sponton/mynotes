            ("referencia", "Referência", "Livro, capítulo, seção, aforismo, página…",
             {"verificada", "incerta"}),
            ("tradicao", "Tradição", "Ex.: Estoicismo, Literatura… (escolha ou escreva)",
             {"pessoal", "verificada", "incerta"}),
            ("idioma", "Idioma original", "Ex.: latim", {"verificada", "incerta"}),
            ("traducao", "Tradução / edição", "Quem traduziu, qual edição; ou “tradução minha”",
