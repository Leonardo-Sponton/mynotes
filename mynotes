    def usar_como_do_dia(self, p=None):
        p = p or self.pens_atual
        if p is None or self.biblioteca is None:
            return
        try:
            self.biblioteca.escolher(date.today(), p["id"])
        except OSError as e:
            self.avisar(f"Não foi possível salvar a escolha: {e.strerror or e}")
            return
        self.avisar("Este é o pensamento de hoje (aqui e no Exame), até você trocar.")
        if self.pilha.get_visible_child_name() == "pensamento":
            self.mostrar_pensamento_biblioteca(p)

    def excluir_pensamento(self, p):
        b = self.biblioteca
        if p is None or b is None or not b.do_usuario(p):
            return
        try:
            desfazer = b.excluir(p["id"])
        except (ValueError, OSError) as e:
            self.avisar(f"Não foi possível excluir: {e}")
            return
        self.atualizar_filtros_pensamento()
        self.recarregar_lista()
        self.abrir_pensamento_do_dia()

        def voltar():
            try:
                b.restaurar(desfazer)
            except OSError as e:
                self.avisar(f"Não foi possível desfazer: {e.strerror or e}")
                return
            self.atualizar_filtros_pensamento()
            self.recarregar_lista()
            self.mostrar_pensamento_biblioteca(b.por_id(p["id"]))
        self.avisar("Pensamento excluído.", "Desfazer", voltar)

