# ======================================================================
# Biblioteca de pensamentos
#   públicos: pensamentos.json que acompanha o app (só leitura; sem nada pessoal)
#   próprios, favoritos e escolhas do dia: ".pensamentos.json" nos dados do usuário
#   (dentro do cofre, quando ele existe)
# ======================================================================
CLASSES_PENSAMENTO = {
    "verificada": ("Citação verificada", "Conferida em uma fonte identificada."),
    "incerta": ("Atribuição incerta", "Circula com este autor, mas a origem não foi confirmada."),
    "pessoal": ("Reflexão pessoal", "Um pensamento seu."),
}
CAMPOS_PENSAMENTO = ("texto", "autor", "epoca", "obra", "referencia", "tradicao", "temas",
                     "idioma", "traducao", "fonte", "observacoes")
MAX_TEXTO_PENSAMENTO = 1500


def chave_pensamento(texto, autor):
    """Texto + autor sem acentos, maiúsculas, pontuação e espaços extras (para achar repetidos)."""
    limpo = lambda s: " ".join(re.sub(r"[^\w\s]", " ", dobrar(s or "")).split())  # noqa: E731
    return limpo(texto), limpo(autor)


def normalizar_pensamento(p):
    d = {}
    for campo in CAMPOS_PENSAMENTO:
        v = p.get(campo)
        if campo == "temas":
            vistos = []
            for t in (v or []):
                t = " ".join(str(t).split()).lower()
                if t and t not in vistos:
                    vistos.append(t)
            d["temas"] = vistos
        else:
            d[campo] = " ".join(str(v or "").split()) if campo not in ("texto", "observacoes") \
                else str(v or "").strip()
    d["classificacao"] = p.get("classificacao", "")
    if d["classificacao"] == "pessoal" and not d["autor"]:
        d["autor"] = ""
    return d


def validar_pensamento(p):
    erros = []
    c = p.get("classificacao")
    texto = (p.get("texto") or "").strip()
    if c not in CLASSES_PENSAMENTO:
        erros.append("Escolha o tipo: reflexão sua, citação verificada ou atribuição incerta.")
    if not texto:
        erros.append("Escreva o texto do pensamento.")
    elif len(texto) > MAX_TEXTO_PENSAMENTO:
        erros.append(f"Texto longo demais ({len(texto)} caracteres): guarde só um trecho curto "
                     f"(até {MAX_TEXTO_PENSAMENTO}).")
    if c == "verificada":
        if not (p.get("autor") or "").strip():
            erros.append("Uma citação precisa do autor.")
        if not (p.get("fonte") or "").strip():
            erros.append("Uma citação verificada precisa da fonte onde você a conferiu (livro e "
                         "edição, página, URL…). Sem fonte, cadastre como “Atribuição incerta”.")
    elif c == "incerta" and not (p.get("autor") or "").strip():
        erros.append("Informe a quem o texto costuma ser atribuído.")
    return erros


def carregar_biblioteca_publica(arq):
    """Devolve (pensamentos, erro). Itens incompletos são deixados de fora."""
    try:
        dados = json.loads(Path(arq).read_text(encoding="utf-8"))
        itens = dados["pensamentos"]
    except (OSError, ValueError, KeyError, TypeError) as e:
        return [], f"Biblioteca de pensamentos não carregada ({e.__class__.__name__})."
    ok, vistos = [], set()
    for item in itens:
        if not isinstance(item, dict) or not item.get("id") or item["id"] in vistos:
            continue
        p = normalizar_pensamento(item)
        if p["classificacao"] not in ("verificada", "incerta") or validar_pensamento(p):
            continue
        p["id"] = str(item["id"])
        vistos.add(p["id"])
        ok.append(p)
    return ok, None


def mesclar_pensamentos(atual, do_backup):
    """Junta os pensamentos próprios de um backup com os atuais (os atuais prevalecem)."""
    atual = atual if isinstance(atual, dict) else {}
    do_backup = do_backup if isinstance(do_backup, dict) else {}
    proprios = [p for p in atual.get("proprios", []) if isinstance(p, dict)]
    ids = {p.get("id") for p in proprios}
    proprios += [p for p in do_backup.get("proprios", []) if isinstance(p, dict) and p.get("id") not in ids]
    favoritos = sorted(set(atual.get("favoritos", [])) | set(do_backup.get("favoritos", [])))
    escolhas = {**do_backup.get("escolhas", {}), **atual.get("escolhas", {})}
    return {"versao": 1, "proprios": proprios, "favoritos": favoritos, "escolhas": escolhas}


class Biblioteca:
    REL = ".pensamentos.json"

    def __init__(self, publicos, armazem):
        self.publicos = publicos
        self.armazem = armazem
        self.proprios: list[dict] = []
        self.favoritos: set[str] = set()
        self.escolhas: dict[str, str] = {}
        self.erro = None
        self.somente_leitura = False
        self.carregar()

    def carregar(self):
        try:
            d = json.loads(self.armazem.ler(self.REL).decode("utf-8"))
        except FileNotFoundError:
            return
        except (OSError, ValueError, UnicodeDecodeError, CofreError) as e:
            # não dá para ler: não grava por cima (senão perderia os pensamentos próprios)
            self.erro = f"Não foi possível ler os seus pensamentos ({e.__class__.__name__})."
            self.somente_leitura = True
            return
        for p in d.get("proprios", []):
            if isinstance(p, dict) and str(p.get("id", "")).startswith("u-"):
                q = normalizar_pensamento(p)
                q["id"], q["criado"] = p["id"], p.get("criado", "")
                self.proprios.append(q)
        self.favoritos = {str(i) for i in d.get("favoritos", [])}
        self.escolhas = {str(k): str(v) for k, v in d.get("escolhas", {}).items()}

    def salvar(self):
        if self.somente_leitura:
            raise OSError(errno.EROFS, "os pensamentos próprios não puderam ser lidos; "
                                       "nada foi gravado por cima")
        dados = {"versao": 1, "proprios": self.proprios, "favoritos": sorted(self.favoritos),
                 "escolhas": self.escolhas}
        self.armazem.gravar(self.REL, json.dumps(dados, ensure_ascii=False, indent=2))

    def _com_volta(self, mudanca, desfazer):
        mudanca()
        try:
            self.salvar()
        except BaseException:
            desfazer()
            raise

    def todos(self):
        return [*self.publicos, *self.proprios]

    def por_id(self, id_):
        return next((p for p in self.todos() if p["id"] == id_), None)

    @staticmethod
    def do_usuario(p):
        return p["id"].startswith("u-")

    def duplicado(self, p, ignorar_id=None):
        k = chave_pensamento(p.get("texto"), p.get("autor"))
        return next((q for q in self.todos()
                     if q["id"] != ignorar_id and chave_pensamento(q["texto"], q["autor"]) == k), None)

    def _preparar(self, p, ignorar_id=None):
        q = normalizar_pensamento(p)
        erros = validar_pensamento(q)
        if not erros and (dup := self.duplicado(q, ignorar_id)):
            erros.append("Este pensamento já está na biblioteca"
                         + (f" ({dup['autor']})." if dup["autor"] else "."))
        if erros:
            raise ValueError("\n".join(erros))
        return q

    def adicionar(self, p):
        import secrets
        q = self._preparar(p)
        q["id"], q["criado"] = f"u-{secrets.token_hex(6)}", agora()
        self._com_volta(lambda: self.proprios.append(q), lambda: self.proprios.remove(q))
        return q

    def editar(self, id_, p):
        atual = next((q for q in self.proprios if q["id"] == id_), None)
        if atual is None:
            raise ValueError("Só os pensamentos adicionados por você podem ser editados.")
        q = self._preparar(p, ignorar_id=id_)
        antes = dict(atual)
        self._com_volta(lambda: atual.update(q), lambda: (atual.clear(), atual.update(antes)))
        return atual

    def excluir(self, id_):
        i = next((i for i, q in enumerate(self.proprios) if q["id"] == id_), None)
        if i is None:
            raise ValueError("Só os pensamentos adicionados por você podem ser excluídos.")
        p = self.proprios[i]
        fav = id_ in self.favoritos
        escolhas = {k: v for k, v in self.escolhas.items() if v == id_}

        def mudar():
            self.proprios.pop(i)
            self.favoritos.discard(id_)
            for k in escolhas:
                del self.escolhas[k]

        def desfazer():
            self.proprios.insert(i, p)
            if fav:
                self.favoritos.add(id_)
            self.escolhas.update(escolhas)
        self._com_volta(mudar, desfazer)
        return desfazer

    def restaurar(self, desfazer):
        """Desfaz uma exclusão (o retorno de excluir())."""
        desfazer()
        self.salvar()

    def favoritar(self, id_, sim=True):
        tinha = id_ in self.favoritos
        self._com_volta(lambda: (self.favoritos.add if sim else self.favoritos.discard)(id_),
                        lambda: (self.favoritos.add if tinha else self.favoritos.discard)(id_))

    def escolher(self, d: date, id_):
        """Fixa um pensamento para o dia d (fica até você trocar de novo)."""
        k = d.isoformat()
        antes = self.escolhas.get(k)
        self._com_volta(lambda: self.escolhas.__setitem__(k, id_),
                        lambda: self.escolhas.__setitem__(k, antes) if antes else self.escolhas.pop(k, None))

    def do_dia(self, d: date):
        """(pensamento, escolhido_por_você). Sem escolha, um dos incluídos no app, que muda a
        cada dia e não muda ao longo do dia."""
        id_ = self.escolhas.get(d.isoformat())
        if id_ and (p := self.por_id(id_)):
            return p, True
        base = self.publicos or self.todos()
        return (base[d.toordinal() % len(base)], False) if base else (None, False)

    def aleatorio(self, evitar=None, rng=None):
        candidatos = [p for p in self.todos() if p["id"] != evitar] or self.todos()
        return (rng or random).choice(candidatos) if candidatos else None

    def filtrar(self, termo="", autor=None, tradicao=None, tema=None, origem=None,
                so_favoritos=False, classificacao=None):
        t = dobrar(termo.strip())
        saida = []
        for p in self.todos():
            if autor and p["autor"] != autor:
                continue
            if tradicao and p["tradicao"] != tradicao:
                continue
            if tema and tema not in p["temas"]:
                continue
            if origem == "app" and self.do_usuario(p) or origem == "usuario" and not self.do_usuario(p):
                continue
            if so_favoritos and p["id"] not in self.favoritos:
                continue
            if classificacao and p["classificacao"] != classificacao:
                continue
            if t and not any(t in dobrar(c) for c in (p["texto"], p["autor"], p["obra"],
                                                       p["referencia"], p["tradicao"], *p["temas"],
                                                       p["observacoes"]) if c):
                continue
            saida.append(p)
        return saida

    def _valores(self, campo):
        vals = set()
        for p in self.todos():
            v = p[campo]
            vals.update(v if isinstance(v, list) else [v] if v else [])
        return sorted(vals, key=dobrar)

    def autores(self):
        return self._valores("autor")

    def tradicoes(self):
        return self._valores("tradicao")

    def temas(self):
        return self._valores("temas")


SOBRE_COMUM = """<b>Onde ficam</b>
• Pasta: <tt>{pasta}</tt>
   notas: <tt>*.md</tt> · diário: <tt>diario/</tt> · exames: <tt>exames/</tt> · tags: <tt>.tags.json</tt>
   pensamentos seus, favoritos e escolhas do dia: <tt>.pensamentos.json</tt>
• Cada registro é um arquivo Markdown comum: dá para abrir em qualquer editor.
• O que você apaga vai para <tt>.lixeira/</tt> (não é esvaziada sozinha).
• Antes de restaurar um backup, o estado atual é guardado em <tt>.seguranca/</tt>.

<b>Proteções que existem</b>
• Pasta e arquivos só podem ser lidos pelo seu usuário (permissões 700/600).
• Cada gravação vai para um arquivo temporário e só depois substitui o original;
   o app relê o arquivo e só então mostra “Salvo”.
• Se uma gravação falhar, o texto continua no app e o aviso “Falha ao salvar” aparece.
• Se outro programa alterar um registro aberto, o app pergunta antes de sobrescrever.
• O app não usa a internet e não escreve o conteúdo das anotações em logs.

<b>O que NÃO existe (ainda)</b>
• Os arquivos <b>não estão criptografados</b>. Sem criptografia de disco (LUKS), quem
   tiver acesso ao disco ou à sua sessão aberta consegue lê-los.
   Para cifrá-los com senha: menu ☰ → “Proteger com senha (criar cofre)…”.
• Não há sincronização nem cópia automática para outro lugar. Use “Fazer backup…” de
   vez em quando e guarde o .zip fora do computador (pendrive, HD externo).
• Não coloque a pasta dos dados em repositórios públicos (GitHub, dotfiles)."""

SOBRE_COFRE = """<b>Como o cofre funciona</b>
• Pasta: <tt>{pasta}</tt> · arquivos cifrados em <tt>cofre/</tt>, chave protegida em <tt>cofre.json</tt>.
• Cada registro (notas, diário, exames, lixeira, tags, pensamentos seus) é um arquivo
   <tt>&lt;código aleatório&gt;.bin</tt> cifrado com XChaCha20-Poly1305 (libsodium, via PyNaCl).
   O nome real, as datas e o conteúdo ficam dentro da parte cifrada.
• A chave do cofre é aleatória (256 bits). No <tt>cofre.json</tt> ela fica cifrada com uma chave
   derivada da sua senha por Argon2id ({ops} passagens, {mem} MiB, salt aleatório).
   A senha não é gravada em lugar nenhum. Chave de recuperação: {recuperacao}.
• Ao abrir um arquivo, a autenticidade é conferida antes de usar o conteúdo: um arquivo
   alterado ou corrompido é recusado (e avisado), nunca lido pela metade.
• Backups (☰ → Fazer backup cifrado) levam os arquivos cifrados e o <tt>cofre.json</tt>: continuam
   protegidos pela senha que o cofre tinha quando foram feitos.
• Bloqueio automático: {bloqueio}. Ctrl+L bloqueia na hora.

<b>O que fica visível no disco, mesmo bloqueado</b>
• Que existe um cofre do MyNotes, quantos arquivos ele tem, o tamanho aproximado de cada um
   (em blocos de 512 bytes) e quando cada arquivo foi gravado pela última vez.
• As preferências em <tt>ajustes.json</tt> (só o tempo do bloqueio automático).
• O acervo público de pensamentos que acompanha o app (não tem nada seu).

<b>Limites (sem promessa de proteção absoluta)</b>
• Com o cofre <b>aberto</b>, o conteúdo está na memória do app e na tela: quem usar a sua
   sessão, um programa malicioso ou alguém com acesso de administrador pode lê-lo.
• O Python não permite apagar com garantia todas as cópias da senha e do texto na memória;
   ao bloquear, o app as descarta, mas não dá para afirmar que sumiram da RAM.
• A criptografia protege os arquivos do cofre. Não protege cópias feitas antes do cofre:
   arquivos antigos em texto puro, backups .zip antigos, snapshots e cópias em outros discos.
   Apagar um arquivo não garante que ele seja irrecuperável (especialmente em SSD).
• Exportar (Markdown/JSON) gera cópias <b>sem proteção</b>; o app avisa antes.
• Esquecer a senha (sem chave de recuperação) torna os dados irrecuperáveis.
• Uma senha só de números, mesmo com {minimo} dígitos, resiste bem menos a força bruta.
• Criptografia de disco (LUKS) protege também o resto do sistema; o cofre não a substitui.
• Snapshots do sistema (Timeshift, Btrfs…) podem não incluir a pasta pessoal, ou incluir
   cópias antigas em texto puro: faça backups cifrados e guarde-os fora do computador."""



