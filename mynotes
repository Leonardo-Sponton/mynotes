    def dialogo_lixeira(self):
        """Lista o que foi apagado (também dentro do cofre) e permite restaurar ou apagar de vez."""
        if self.repo is None:
            return None
        self.salvar_agora()
        d = Adw.Dialog(title="Lixeira", content_width=620, content_height=640)
        lista = Gtk.ListBox(css_classes=["boxed-list"], selection_mode=Gtk.SelectionMode.NONE)
        vazio = Gtk.Label(label="A lixeira está vazia.", css_classes=["dica"], margin_top=20)

        def recarregar():
            limpar(lista)
            itens = self.repo.lixeira() if self.repo else []
            vazio.set_visible(not itens)
            for rel in reversed(itens):
                try:
                    tipo, _orig, reg = self.repo.item_lixeira(rel)
                except (OSError, UnicodeDecodeError, CofreError, ValueError):
                    continue
                nome = TIPOS[tipo][1] if tipo else "Cópia de conflito"
                linha = Gtk.Box(spacing=10, margin_start=10, margin_end=8, margin_top=6, margin_bottom=6)
                textos = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, hexpand=True)
                textos.append(Gtk.Label(label=reg.titulo_exibido(), xalign=0, wrap=True,
                                        css_classes=["lista-titulo"]))
                textos.append(Gtk.Label(label=f"{nome} · modificado em {mostrar_data(reg.modificada)}",
                                        xalign=0, css_classes=["lista-data"]))
                linha.append(textos)
                bt_r = Gtk.Button(label="Restaurar", valign=Gtk.Align.CENTER)
                bt_r.connect("clicked", lambda *_, x=rel: restaurar(x))
                bt_x = Gtk.Button(icon_name="user-trash-symbolic", css_classes=["flat"],
                                  valign=Gtk.Align.CENTER, tooltip_text="Apagar de vez (pede confirmação)")
                bt_x.connect("clicked", lambda *_, x=rel, t=reg.titulo_exibido(): apagar(x, t))
                linha.append(bt_r)
                linha.append(bt_x)
                lista.append(linha)

        def restaurar(rel):
            try:
                novo = self.repo.restaurar_item_lixeira(rel)
            except (OSError, CofreError) as e:
                self.avisar(f"Não foi possível restaurar: {e}")
                return
            if novo is None:
                self.avisar("Já existe um registro neste dia; o item continua na lixeira.")
                return
            self.carregar_tudo()
            self.recarregar_lista()
            self.marcar_calendario()
            recarregar()
            self.avisar("Restaurado.")

        def apagar(rel, titulo):
            c = Adw.AlertDialog(heading="Apagar de vez?",
                                body=f"“{titulo}” será apagado definitivamente"
                                     + (" do cofre." if self.repo.cifrado else ". Em SSDs e backups "
                                        "antigos, cópias podem continuar existindo."))
            c.add_response("cancelar", "Cancelar")
            c.add_response("apagar", "Apagar de vez")
            c.set_response_appearance("apagar", Adw.ResponseAppearance.DESTRUCTIVE)
            c.set_default_response("cancelar")

            def resp(_c, rr):
                if rr == "apagar" and self.repo is not None:
                    try:
                        self.repo.armazem.apagar(rel)
                    except (OSError, KeyError) as e:
                        self.avisar(f"Não foi possível apagar: {e}")
                    recarregar()
            c.connect("response", resp)
            self.apresentar(c)
        d.restaurar, d.recarregar, d.lista = restaurar, recarregar, lista
        caixa = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10,
                        margin_start=18, margin_end=18, margin_top=8, margin_bottom=18)
        caixa.append(Gtk.Label(label="O que você apaga vem para cá. Nada é apagado de vez sem você "
                                     "pedir." + (" Com o cofre, a lixeira também fica cifrada."
                                                 if self.repo.cifrado else ""),
                               xalign=0, wrap=True, css_classes=["dica"]))
        caixa.append(Gtk.ScrolledWindow(child=lista, vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER))
        caixa.append(vazio)
        recarregar()
        tv = Adw.ToolbarView(content=caixa)
        tv.add_top_bar(Adw.HeaderBar())
        d.set_child(tv)
        self.apresentar(d)
        return d

    def dialogo_remover_texto_puro(self):
        if self.repo is None or not self.repo.cifrado:
            return None
        achados = levantar_texto_puro(self.pasta)
        iguais = 0
        for rel, p in achados["registros"].items():
            with contextlib.suppress(OSError, CofreError):
                iguais += self.repo.armazem.existe(rel) and self.repo.armazem.ler(rel) == p.read_bytes()
        n, nc = len(achados["registros"]), len(achados["copias"])
        if not n and not nc:
            self.avisar("Não há arquivos em texto puro de antes do cofre.")
            self.atualizar_menu()
            return None
        d = Adw.AlertDialog(
            heading="Remover os arquivos antigos em texto puro?",
            body=f"Em {self.pasta} ainda existem {n} arquivo(s) de antes do cofre; {iguais} deles "
                 f"são idênticos ao que está no cofre e podem ser apagados. Os que forem diferentes "
                 f"ficam onde estão. Há também {nc} cópia(s) .zip / temporário(s) em texto puro.\n\n"
                 "Antes, confira os seus registros no app e, de preferência, faça um backup cifrado "
                 "(menu ☰).\n\n"
                 "Apagar um arquivo não garante que ele seja irrecuperável: em SSDs, em snapshots do "
                 "sistema de arquivos, em backups antigos, pendrives ou na nuvem, cópias podem "
                 "continuar existindo. Para uma garantia forte, use também criptografia de disco "
                 "(LUKS).")
        copias = caixa_marcar("Apagar também as cópias .zip em texto puro (backups antigos e a "
                              "cópia feita na migração)")
        d.set_extra_child(copias)
        d.add_response("cancelar", "Cancelar")
        d.add_response("apagar", "Apagar arquivos em texto puro")
        d.set_response_appearance("apagar", Adw.ResponseAppearance.DESTRUCTIVE)
        d.set_default_response("cancelar")

        def resposta(_d, resp):
            if resp != "apagar" or self.repo is None:
                return
            try:
                removidos, mantidos = remover_texto_puro(self.pasta, self.repo.armazem,
                                                         incluir_copias=copias.get_active())
            except OSError as e:
                self.erro_dialogo("Não foi possível apagar tudo", str(e))
                return
            self.atualizar_menu()
            texto = f"{len(removidos)} arquivo(s) apagado(s)."
            if mantidos:
                texto += f"\n\nMantidos ({len(mantidos)}):\n" + "\n".join(
                    f"• {p.relative_to(self.pasta)}: {m}" for p, m in mantidos[:8])
            self.erro_dialogo("Arquivos em texto puro removidos", texto)
        d.connect("response", resposta)
        d.copias = copias
        self.apresentar(d)
        return d

    # ------------------------------------------------------------------
    # exportação, backup e privacidade
    # ------------------------------------------------------------------
    def exportar(self):
        self.salvar_agora()
        if self.repo is not None and self.repo.cifrado:
            d = Adw.AlertDialog(
                heading="Exportar sem proteção?",
                body="A exportação cria arquivos Markdown e JSON em texto puro, legíveis por "
                     "qualquer programa. Eles NÃO ficam protegidos pelo cofre: quem tiver acesso à "
                     "pasta onde você salvar poderá lê-los, e apagá-los depois não garante que "
                     "sumam do disco.\n\nPara guardar uma cópia protegida, use “Fazer backup "
                     "cifrado”.")
            d.add_response("cancelar", "Cancelar")
            d.add_response("exportar", "Exportar sem proteção")
            d.set_response_appearance("exportar", Adw.ResponseAppearance.DESTRUCTIVE)
            d.set_default_response("cancelar")
            d.connect("response", lambda _d, r: r == "exportar" and self._escolher_pasta_exportacao())
            return self.apresentar(d)
        self._escolher_pasta_exportacao()
        return None

    def _escolher_pasta_exportacao(self):
        dlg = Gtk.FileDialog(title="Onde criar a pasta da exportação?", accept_label="Exportar aqui",
                             initial_folder=Gio.File.new_for_path(str(Path.home())))
        dlg.select_folder(self, None, self._exportar_fim)

    def _exportar_fim(self, dlg, res):
        try:
            pasta = dlg.select_folder_finish(res)
        except GLib.Error:
            return      # cancelado
        if self.repo is None:
            return      # o cofre foi bloqueado nesse meio-tempo
        try:
            alvo = self.repo.exportar(pasta.get_path())
        except (OSError, ValueError, CofreError) as e:
            self.erro_dialogo("Não foi possível exportar", str(e))
            return
        self.avisar(f"Exportado para {alvo}" + (" (sem proteção)" if self.repo.cifrado else ""),
                    "Abrir pasta", lambda: self.abrir_pasta(alvo))

    def fazer_backup(self):
        self.salvar_agora()
        nome = f"mynotes-backup-{'cifrado-' if self.repo and self.repo.cifrado else ''}{date.today()}.zip"
        dlg = Gtk.FileDialog(title="Salvar backup", initial_name=nome,
                             initial_folder=Gio.File.new_for_path(str(Path.home())))
        dlg.save(self, None, self._backup_fim)

    def _backup_fim(self, dlg, res):
        try:
            arq = dlg.save_finish(res)
        except GLib.Error:
            return
        if self.repo is None:
            return
        try:
            n = self.repo.fazer_backup(arq.get_path())
        except (OSError, ValueError, zipfile.BadZipFile, CofreError) as e:
            self.erro_dialogo("Não foi possível criar o backup", str(e))
            return
        tipo = "cifrado " if self.repo.cifrado else ""
        self.avisar(f"Backup {tipo}criado com {n} registro(s): {arq.get_path()}")

    def restaurar_backup(self):
        self.salvar_agora()
        if self.pendentes:
            self.erro_dialogo("Há alterações não salvas",
                              "Resolva o aviso “Falha ao salvar”/“Conflito” antes de restaurar.")
            return
        filtro = Gtk.FileFilter(name="Backup do MyNotes (.zip)")
        filtro.add_pattern("*.zip")
        filtros = Gio.ListStore.new(Gtk.FileFilter)
        filtros.append(filtro)
        dlg = Gtk.FileDialog(title="Escolha o backup", filters=filtros,
                             initial_folder=Gio.File.new_for_path(str(Path.home())))
        dlg.open(self, None, self._restaurar_escolhido)

    def _restaurar_escolhido(self, dlg, res):
        try:
            arq = dlg.open_finish(res).get_path()
        except GLib.Error:
            return
        if self.repo is None:
            return
        cifrado = self.repo.cifrado
        d = Adw.AlertDialog(
            heading="Restaurar este backup?",
            body="O backup inteiro é conferido antes de qualquer mudança. Registros com o mesmo nome "
                 "serão substituídos pela versão do backup; os outros continuam como estão. Antes "
                 f"disso, uma cópia {'cifrada ' if cifrado else ''}do estado atual é guardada em "
                 f"{self.repo.seguranca}. Se algo falhar no meio, o que já tinha sido gravado é "
                 "desfeito.")
        d.add_response("cancelar", "Cancelar")
        d.add_response("restaurar", "Restaurar")
        d.set_response_appearance("restaurar", Adw.ResponseAppearance.DESTRUCTIVE)
        d.connect("response", lambda _d, r: r == "restaurar" and self._restaurar(arq))
        self.apresentar(d)

    def _restaurar(self, arq, senha=None):
        if self.repo is None:
            return
        repo = self.repo

        def fim(resultado, e):
            if self.repo is not repo:
                return
            if isinstance(e, PrecisaSenha):
                self.pedir_senha_backup(arq)
                return
            if isinstance(e, SenhaIncorreta):
                self.erro_dialogo("Senha incorreta", "A senha não abre este backup. Nada foi restaurado.")
                return
            if e is not None:
                self.erro_dialogo("Não foi possível restaurar",
                                  f"{e}\n\nO estado anterior foi mantido.")
                return
            n, ignorados, copia = resultado
            self.atual = None
            self.tags = self.repo.carregar_tags()
            self.biblioteca = Biblioteca(self.publicos, self.repo.armazem)
            self.carregar_tudo()
            if self.modo == "nota":
                self.recarregar_lista()
            elif self.modo == "pensamento":
                self.atualizar_filtros_pensamento()
                self.recarregar_lista()
                self.abrir_pensamento_do_dia()
            else:
                self.abrir_dia(self.datas[self.modo])
            extra = f" ({ignorados} arquivo(s) desconhecido(s) ignorado(s))" if ignorados else ""
            self.avisar(f"{n} registro(s) restaurado(s){extra}. Cópia do estado anterior: {copia.name}")
        self.em_segundo_plano(lambda: repo.restaurar_backup(arq, senha), fim)

    def pedir_senha_backup(self, arq):
        entrada = Gtk.PasswordEntry(show_peek_icon=True, placeholder_text="Senha (ou chave de "
                                                                          "recuperação) do backup")
        d = Adw.AlertDialog(
            heading="Este backup usa outra senha",
            body="O backup foi feito com outra senha ou por outro cofre. Digite a senha que o cofre "
                 "tinha quando o backup foi feito (ou a chave de recuperação da época). Os registros "
                 "restaurados serão cifrados de novo com a chave deste cofre.")
        d.set_extra_child(entrada)
        d.add_response("cancelar", "Cancelar")
        d.add_response("restaurar", "Restaurar")
        d.set_response_appearance("restaurar", Adw.ResponseAppearance.SUGGESTED)
        d.connect("response", lambda _d, r: r == "restaurar" and entrada.get_text()
                  and self._restaurar(arq, entrada.get_text()))
        self.apresentar(d)

    def erro_dialogo(self, titulo, texto):
        d = Adw.AlertDialog(heading=titulo, body=texto)
        d.add_response("ok", "OK")
        self.apresentar(d)
        return d

    def sobre_dados(self):
        cifrado = self.repo is not None and self.repo.cifrado
        texto = (SOBRE_COFRE if cifrado else SOBRE_COMUM).format(
            pasta=GLib.markup_escape_text(caminho_curto(self.pasta)),
            ops=KDF_OPS, mem=KDF_MEM >> 20, minimo=MIN_SENHA,
            recuperacao="existe" if tem_recuperacao(self.pasta) else "não existe",
            bloqueio=(f"após {self.ajustes.get('bloqueio_min')} minutos sem uso"
                      if self.ajustes.get("bloqueio_min") else "desligado"))
        dialogo = Adw.Dialog(title="Onde ficam os dados", content_width=680, content_height=640)
        lbl = Gtk.Label(label=texto, use_markup=True, wrap=True, xalign=0, selectable=True,
                        margin_start=22, margin_end=22, margin_top=8, margin_bottom=22)
        tv = Adw.ToolbarView(content=Gtk.ScrolledWindow(child=lbl))
        tv.add_top_bar(Adw.HeaderBar())
        dialogo.set_child(tv)
        self.apresentar(dialogo)


def caixa_marcar(texto):
    """CheckButton cujo texto quebra linha (não força o diálogo a ficar largo)."""
    return Gtk.CheckButton(child=Gtk.Label(label=texto, wrap=True, xalign=0))


def limpar(caixa):
    """Tira todos os filhos de um Gtk.Box / Adw.WrapBox."""
    if hasattr(caixa, "remove_all"):
        caixa.remove_all()
        return
    while (filho := caixa.get_first_child()) is not None:
        caixa.remove(filho)


class App(Adw.Application):
    def __init__(self, repo: Repositorio | None = None):
        super().__init__(application_id=APP_ID)
        self.repo = repo

    def do_startup(self):
        Adw.Application.do_startup(self)
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK)
        css = Gtk.CssProvider()
        css.load_from_string(CSS)
        # acima do ~/.config/gtk-4.0/gtk.css (prioridade USER) para valer a paleta do app
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), css,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_USER + 1)

    def do_activate(self):
        win = self.props.active_window
        if win is None:
            if self.repo is None and cofre_existe(PASTA):
                win = Janela(self, None, pasta=PASTA)      # pede a senha
            else:
                win = Janela(self, self.repo or Repositorio(PASTA))
        win.present()


if __name__ == "__main__":
    sys.exit(App().run(sys.argv))
